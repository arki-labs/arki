{
  "extends": "@arki/tsconfig/base.json",
  "compilerOptions": {
    /**
     * Editor, lint, test and doc-example config for every file. Bundler resolution here so the
     * React files type-check: `@phosphor-icons/react` (behind `@arki/icons/phosphor`, used by
     * `./react` and `./react/templates`) ships `.d.ts` files with extensionless relative imports,
     * which NodeNext cannot resolve. The build is split: `tsconfig.build.json` (NodeNext) emits
     * the server and portable entries, `tsconfig.build.react.json` (Bundler) only the icon files.
     * `typecheck` runs this config and the NodeNext one.
     */
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": false,
    "allowImportingTsExtensions": false,
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "dom", "dom.iterable"],
    "rootDir": "./src",
    "outDir": "./dist",
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
