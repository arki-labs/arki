{
  "name": "@arki/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts",
      "types": "./dist/index.d.ts"
    },
    "./errors": {
      "default": "./src/errors.ts",
      "types": "./dist/errors.d.ts"
    },
    "./password": {
      "default": "./src/password.ts",
      "types": "./dist/password.d.ts"
    },
    "./token": {
      "default": "./src/token.ts",
      "types": "./dist/token.d.ts"
    },
    "./security/*": {
      "default": "./src/security/*.ts",
      "types": "./dist/security/*.d.ts"
    },
    "./email/schema": {
      "default": "./src/email/schema.ts",
      "types": "./dist/email/schema.d.ts"
    }
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@arki/emails": "workspace:*",
    "@arki/kv": "workspace:*",
    "@arki/nextjs": "workspace:*",
    "@arki/schema": "workspace:*",
    "@auth/core": "^0.38.0",
    "@auth/drizzle-adapter": "^1.8.0",
    "@paralleldrive/cuid2": "^2.2.2",
    "bcrypt": "5.1.1",
    "next-auth": "beta",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@arki/eslint-config": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "@types/bcrypt": "5.0.2"
  }
}
