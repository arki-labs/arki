{
  "name": "@arki/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts",
      "types": "./dist/index.d.ts"
    },
    "./security/*": {
      "default": "./src/security/*.ts",
      "types": "./dist/security/*.d.ts"
    },
    "./email/schema": {
      "default": "./src/email/schema.ts",
      "types": "./dist/email/schema.d.ts"
    },
    "./*": "./src/*.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@arki/db": "workspace:*",
    "@arki/emails": "workspace:*",
    "@arki/kv": "workspace:*",
    "@arki/nextjs": "workspace:*",
    "@arki/schema": "workspace:*",
    "@auth/core": "^0.40.0",
    "@auth/drizzle-adapter": "^1.10.0",
    "@better-auth/expo": "catalog:better-auth",
    "@daveyplate/better-auth-ui": "catalog:better-auth",
    "@paralleldrive/cuid2": "^2.2.2",
    "@t3-oss/env-core": "catalog:env",
    "bcrypt": "6.0.0",
    "better-auth": "catalog:better-auth",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@arki/eslint-config": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "@types/bcrypt": "6.0.0"
  }
}
