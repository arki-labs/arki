{
  "name": "@arki/auth",
  "version": "0.1.3",
  "description": "Sign-in for Arki apps: one definition, one Postgres-backed engine, and the principal, guards and client types inferred from your own tables.",
  "repository": {
    "type": "git",
    "url": "https://github.com/arki-labs/arki.git",
    "directory": "packages/auth"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ids": {
      "types": "./dist/ids.d.ts",
      "import": "./dist/ids.js",
      "default": "./dist/ids.js"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "import": "./dist/zod.js",
      "default": "./dist/zod.js"
    },
    "./password": {
      "types": "./dist/password.d.ts",
      "import": "./dist/password.js",
      "default": "./dist/password.js"
    },
    "./workspaces": {
      "types": "./dist/workspaces.d.ts",
      "import": "./dist/workspaces.js",
      "default": "./dist/workspaces.js"
    },
    "./pg": {
      "types": "./dist/pg/index.d.ts",
      "import": "./dist/pg/index.js",
      "default": "./dist/pg/index.js"
    },
    "./pg/workspaces": {
      "types": "./dist/pg/workspaces/index.d.ts",
      "import": "./dist/pg/workspaces/index.js",
      "default": "./dist/pg/workspaces/index.js"
    },
    "./dot": {
      "types": "./dist/dot.d.ts",
      "import": "./dist/dot.js",
      "default": "./dist/dot.js"
    },
    "./orpc": {
      "types": "./dist/orpc.d.ts",
      "import": "./dist/orpc.js",
      "default": "./dist/orpc.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js",
      "default": "./dist/http.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    },
    "./react/templates": {
      "types": "./dist/react/templates/index.d.ts",
      "import": "./dist/react/templates/index.js",
      "default": "./dist/react/templates/index.js"
    },
    "./tanstack-start": {
      "types": "./dist/tanstack-start/index.d.ts",
      "import": "./dist/tanstack-start/index.js",
      "default": "./dist/tanstack-start/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    },
    "./testing/tanstack-start": {
      "types": "./dist/testing/tanstack-start.d.ts",
      "import": "./dist/testing/tanstack-start.js",
      "default": "./dist/testing/tanstack-start.js"
    },
    "./testing/playwright": {
      "types": "./dist/testing/playwright.d.ts",
      "import": "./dist/testing/playwright.js",
      "default": "./dist/testing/playwright.js"
    },
    "./testing/production-boot": {
      "types": "./dist/testing/production-boot.d.ts",
      "import": "./dist/testing/production-boot.js",
      "default": "./dist/testing/production-boot.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "import": "./dist/env.js",
      "default": "./dist/env.js"
    },
    "./tweaks-column": {
      "types": "./dist/tweaks-column.d.ts",
      "import": "./dist/tweaks-column.js",
      "default": "./dist/tweaks-column.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**",
    "src/**",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/*.test-d.ts",
    "!src/**/__fixtures__/**",
    "docs/**",
    "!docs/examples/*.test.ts",
    "!docs/examples/tsconfig.json",
    "!docs/USER_VS_ACCOUNT.md",
    "llms.txt",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "rm -f .cache/tsbuildinfo.build.json .cache/tsbuildinfo.build.react.json && tsc -b --force tsconfig.build.react.json",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc -b --watch tsconfig.build.react.json",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "test": "vitest run",
    "test:docs": "arki-doc-examples",
    "test:runtimes": "arki-runtimes",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.build.json --composite false --incremental false"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@arki/contracts": "workspace:*",
    "@arki/db": "workspace:*",
    "@arki/env": "workspace:*",
    "@arki/failure": "workspace:*",
    "@arki/kv": "workspace:*",
    "@arki/log": "workspace:*",
    "@arki/mail": "workspace:*",
    "@better-auth/expo": "catalog:better-auth",
    "@daveyplate/better-auth-tanstack": "catalog:",
    "@daveyplate/better-auth-ui": "catalog:better-auth",
    "@noble/hashes": "^2.2.0",
    "better-auth": "catalog:better-auth",
    "drizzle-orm": "catalog:drizzle",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@arki/dot": "workspace:*",
    "@arki/eslint-config": "workspace:*",
    "@arki/http": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "@electric-sql/pglite": "catalog:",
    "@orpc/server": "catalog:backend",
    "@playwright/test": "catalog:testing",
    "@tanstack/react-router": "catalog:tanstack/start",
    "@tanstack/react-start": "catalog:tanstack/start",
    "@testcontainers/postgresql": "catalog:testing",
    "@types/node": "catalog:node",
    "@types/pg": "catalog:drizzle",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "drizzle-kit": "catalog:drizzle",
    "pg": "catalog:drizzle",
    "rate-limiter-flexible": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@arki/dot": "workspace:*",
    "@arki/http": "workspace:*",
    "@arki/icons": "workspace:*",
    "@arki/ui": "workspace:*",
    "@electric-sql/pglite": "catalog:",
    "@orpc/server": "catalog:backend",
    "@playwright/test": "catalog:testing",
    "@tanstack/react-router": "catalog:tanstack/start",
    "@tanstack/react-start": "catalog:tanstack/start",
    "drizzle-kit": "catalog:drizzle",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "vitest": "catalog:"
  },
  "peerDependenciesMeta": {
    "@arki/dot": {
      "optional": true
    },
    "@arki/http": {
      "optional": true
    },
    "@arki/icons": {
      "optional": true
    },
    "@arki/ui": {
      "optional": true
    },
    "@electric-sql/pglite": {
      "optional": true
    },
    "@orpc/server": {
      "optional": true
    },
    "@playwright/test": {
      "optional": true
    },
    "@tanstack/react-router": {
      "optional": true
    },
    "@tanstack/react-start": {
      "optional": true
    },
    "drizzle-kit": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "arki": {
    "runtimes": [
      "node",
      "bun",
      "deno",
      "browser"
    ]
  }
}
