{
  "name": "@arki/auth",
  "version": "0.1.3",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./src/index.ts",
      "node": "./src/index.ts"
    },
    "./dot": {
      "types": "./dist/src/dot.d.ts",
      "import": "./src/dot.ts",
      "node": "./src/dot.ts"
    },
    "./tanstack-start": {
      "types": "./dist/src/tanstack-start/index.d.ts",
      "import": "./src/tanstack-start/index.ts",
      "node": "./src/tanstack-start/index.ts"
    },
    "./react": {
      "types": "./dist/src/react/index.d.ts",
      "import": "./src/react/index.ts",
      "browser": "./src/react/index.ts"
    },
    "./react/templates": {
      "types": "./dist/src/react/templates/index.d.ts",
      "import": "./src/react/templates/index.ts",
      "browser": "./src/react/templates/index.ts"
    },
    "./workspaces": {
      "types": "./dist/src/workspaces/server/index.d.ts",
      "import": "./src/workspaces/server/index.ts",
      "node": "./src/workspaces/server/index.ts"
    },
    "./security/*": {
      "types": "./dist/src/security/*.d.ts",
      "import": "./src/security/*.ts",
      "node": "./src/security/*.ts"
    },
    "./email/schema": {
      "types": "./dist/src/email/schema.d.ts",
      "import": "./src/email/schema.ts",
      "node": "./src/email/schema.ts"
    },
    "./tweaks-column": {
      "types": "./dist/src/tweaks-column.d.ts",
      "import": "./src/tweaks-column.ts",
      "node": "./src/tweaks-column.ts"
    },
    "./*": {
      "types": "./dist/src/*.d.ts",
      "import": "./src/*.ts",
      "node": "./src/*.ts"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@arki/contracts": "workspace:*",
    "@arki/db": "workspace:*",
    "@arki/emails": "workspace:*",
    "@arki/env": "workspace:*",
    "@arki/kv": "workspace:*",
    "@arki/log": "workspace:*",
    "@auth/core": "catalog:",
    "@auth/drizzle-adapter": "catalog:drizzle",
    "@better-auth/expo": "catalog:better-auth",
    "@daveyplate/better-auth-tanstack": "catalog:",
    "@daveyplate/better-auth-ui": "catalog:better-auth",
    "@paralleldrive/cuid2": "catalog:utilities",
    "@t3-oss/env-core": "catalog:env",
    "bcrypt": "catalog:",
    "better-auth": "catalog:better-auth",
    "drizzle-orm": "catalog:drizzle",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@arki/dot": "workspace:*",
    "@arki/icons": "workspace:*",
    "@arki/ui": "workspace:*",
    "@playwright/test": "catalog:testing",
    "@tanstack/react-router": "catalog:tanstack/start",
    "@tanstack/react-start": "catalog:tanstack/start",
    "react": "catalog:react",
    "react-dom": "catalog:react"
  },
  "peerDependenciesMeta": {
    "@arki/dot": {
      "optional": true
    },
    "@arki/icons": {
      "optional": true
    },
    "@arki/ui": {
      "optional": true
    },
    "@playwright/test": {
      "optional": true
    },
    "@tanstack/react-router": {
      "optional": true
    },
    "@tanstack/react-start": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arki/dot": "workspace:*",
    "@arki/eslint-config": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "@playwright/test": "catalog:testing",
    "@tanstack/react-router": "catalog:tanstack/start",
    "@tanstack/react-start": "catalog:tanstack/start",
    "@types/bcrypt": "catalog:types",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react"
  }
}
