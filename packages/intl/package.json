{
  "name": "@arki/intl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./next-client": {
      "types": "./dist/src/integrations/next/client.d.ts",
      "import": "./src/integrations/next/client.ts",
      "browser": "./src/integrations/next/client.ts"
    },
    "./next-middleware": {
      "types": "./dist/src/integrations/next/middleware.d.ts",
      "import": "./src/integrations/next/middleware.ts",
      "node": "./src/integrations/next/middleware.ts"
    },
    "./next-routing": {
      "types": "./dist/src/integrations/next/routing.d.ts",
      "import": "./src/integrations/next/routing.ts",
      "node": "./src/integrations/next/routing.ts"
    },
    "./next-navigation": {
      "types": "./dist/src/integrations/next/navigation.d.ts",
      "import": "./src/integrations/next/navigation.ts",
      "node": "./src/integrations/next/navigation.ts"
    },
    "./next-shared": {
      "types": "./dist/src/integrations/next/shared.d.ts",
      "import": "./src/integrations/next/shared.ts",
      "node": "./src/integrations/next/shared.ts"
    },
    "./language": {
      "types": "./dist/src/language.d.ts",
      "import": "./src/language.ts",
      "node": "./src/language.ts"
    },
    "./dictionaries": {
      "types": "./dist/src/dictionaries.d.ts",
      "import": "./src/dictionaries.ts",
      "node": "./src/dictionaries.ts"
    },
    "./types": {
      "types": "./dist/src/types.d.ts",
      "import": "./src/types.ts",
      "browser": "./src/types.ts"
    },
    "./tanstack-start": {
      "types": "./dist/src/integrations/tanstack-start/index.d.ts",
      "import": "./src/integrations/tanstack-start/index.ts",
      "browser": "./src/integrations/tanstack-start/index.ts"
    },
    "./slug-registry": {
      "types": "./dist/src/slug-registry.d.ts",
      "import": "./src/slug-registry.ts",
      "browser": "./src/slug-registry.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "build": "tsc"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "all-iso-language-codes": "catalog:",
    "cldr-core": "catalog:",
    "full-icu": "catalog:",
    "next-intl": "catalog:",
    "react-intl": "catalog:"
  },
  "devDependencies": {
    "@arki/eslint-config": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react"
  },
  "sideEffects": false
}
