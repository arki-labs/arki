{
  "name": "@arki/bench",
  "version": "0.0.2",
  "description": "Benchmarks you can publish: compare a library against its competitors under executable contracts, with honest statistics, full provenance, bundle-size budgets and README tables generated from saved results. Built on mitata.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arki-labs/arki.git"
  },
  "homepage": "https://arki.dev",
  "bugs": {
    "url": "https://github.com/arki-labs/arki/issues"
  },
  "keywords": [
    "arki",
    "benchmark",
    "bench",
    "performance",
    "mitata",
    "statistics",
    "bundle-size",
    "regression",
    "ci",
    "typescript"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/cli.js",
    "./dist/node/worker.js",
    "./dist/node/size-worker.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js",
      "default": "./dist/node/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**",
    "src/**",
    "!src/**/*.test.*",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "bin": {
    "arki-bench": "./dist/cli.js"
  },
  "dependencies": {
    "mitata": "1.0.34",
    "zod": "4.6.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.10"
  }
}
