{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /**
     * Emit JavaScript and declarations for every entry, so plain Node and Vite load the package
     * without compiling it. Every relative import names its `.js` file, so the emitted `dist/`
     * loads as plain ESM.
     */
    "emitDeclarationOnly": false,
    "allowImportingTsExtensions": false,
    "jsx": "react-jsx"
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/__fixtures__/**"]
}
