{
  "name": "@arki/icons",
  "version": "0.1.2",
  "private": false,
  "description": "Icon sets for ARKI apps — Iconify, Phosphor, Simple Icons and flag packs behind one React entry point.",
  "keywords": [
    "arki",
    "typescript",
    "react",
    "icons",
    "iconify",
    "phosphor"
  ],
  "homepage": "https://arki.dev",
  "bugs": {
    "url": "https://github.com/arki-labs/arki/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arki-labs/arki.git",
    "directory": "packages/icons"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./src/index.ts",
      "browser": "./src/index.ts"
    },
    "./flags": {
      "types": "./dist/src/flags/index.d.ts",
      "import": "./src/flags/index.tsx",
      "browser": "./src/flags/index.tsx"
    },
    "./brands": {
      "types": "./dist/src/brands/index.d.ts",
      "import": "./src/brands/index.ts",
      "browser": "./src/brands/index.ts"
    },
    "./phosphor": {
      "types": "./dist/src/phosphor.d.ts",
      "import": "./src/phosphor.ts",
      "browser": "./src/phosphor.ts"
    },
    "./phosphor/ssr": {
      "types": "./dist/src/phosphor-ssr.d.ts",
      "import": "./src/phosphor-ssr.ts",
      "browser": "./src/phosphor-ssr.ts"
    },
    "./phosphor/defaults": {
      "types": "./dist/src/phosphor-defaults.d.ts",
      "import": "./src/phosphor-defaults.tsx",
      "browser": "./src/phosphor-defaults.tsx"
    },
    "./vite": {
      "types": "./dist/src/vite.d.ts",
      "default": "./dist/src/vite.js"
    },
    "./spinners": {
      "types": "./dist/src/spinners/index.d.ts",
      "import": "./src/spinners/index.ts",
      "browser": "./src/spinners/index.ts"
    },
    "./brands/index": {
      "types": "./dist/src/brands/index.d.ts",
      "import": "./src/brands/index.ts",
      "browser": "./src/brands/index.ts"
    },
    "./home": {
      "types": "./dist/src/home.d.ts",
      "import": "./src/home.ts",
      "browser": "./src/home.ts"
    },
    "./index": {
      "types": "./dist/src/index.d.ts",
      "import": "./src/index.ts",
      "browser": "./src/index.ts"
    },
    "./phosphor-ssr": {
      "types": "./dist/src/phosphor-ssr.d.ts",
      "import": "./src/phosphor-ssr.ts",
      "browser": "./src/phosphor-ssr.ts"
    },
    "./spinners/index": {
      "types": "./dist/src/spinners/index.d.ts",
      "import": "./src/spinners/index.ts",
      "browser": "./src/spinners/index.ts"
    },
    "./types": {
      "types": "./dist/src/types.d.ts",
      "import": "./src/types.ts",
      "browser": "./src/types.ts"
    },
    "./wc": {
      "types": "./dist/src/wc.d.ts",
      "import": "./src/wc.ts",
      "browser": "./src/wc.ts"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/src/index.d.ts",
  "typesVersions": {
    "*": {
      "flags": [
        "src/flags/index.tsx"
      ],
      "brands": [
        "src/brands/index.ts"
      ],
      "phosphor": [
        "src/phosphor.ts"
      ],
      "phosphor/ssr": [
        "src/phosphor-ssr.ts"
      ],
      "phosphor/defaults": [
        "src/phosphor-defaults.tsx"
      ],
      "vite": [
        "src/vite.ts"
      ],
      "spinners": [
        "src/spinners/index.ts"
      ],
      "brands/index": [
        "src/brands/index.ts"
      ],
      "home": [
        "src/home.ts"
      ],
      "index": [
        "src/index.ts"
      ],
      "phosphor-ssr": [
        "src/phosphor-ssr.ts"
      ],
      "spinners/index": [
        "src/spinners/index.ts"
      ],
      "types": [
        "src/types.ts"
      ],
      "wc": [
        "src/wc.ts"
      ]
    }
  },
  "files": [
    "dist/**",
    "!dist/**/*.spec.*",
    "!dist/**/*.test.*",
    "src/**",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/tests/**",
    "!src/**/test/**",
    "!src/**/__tests__/**",
    "docs/agent-guide.md",
    "llms.txt",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "bench": "bun run build && arki-bench",
    "build": "tsc && tsc -p tsconfig.vite.json",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "test": "vitest run",
    "test:docs": "arki-doc-examples",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@iconify-icon/react": "catalog:",
    "@iconify/json": "catalog:",
    "@iconify/react": "catalog:",
    "@iconify/tailwind4": "catalog:",
    "@phosphor-icons/react": "catalog:",
    "flag-icons": "catalog:",
    "flagpack-core": "catalog:",
    "react-flagpack": "catalog:",
    "react-icons": "catalog:",
    "simple-icons": "catalog:",
    "unplugin-icons": "catalog:"
  },
  "devDependencies": {
    "@arki/bench": "workspace:*",
    "@arki/eslint-config": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "vite": "catalog:build-tools",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:react",
    "vite": "^7 || ^8"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "module:jsx": "src"
}
