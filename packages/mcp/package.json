{
  "name": "@arki/mcp",
  "version": "0.1.0",
  "private": false,
  "description": "MCP servers and MCP Apps for ARKI — tools from oRPC procedures with their middleware intact, typed access, confirmations, a test client and the Dot mcpServer() plugin.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/arki-labs/arki.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://arki.dev",
  "bugs": {
    "url": "https://github.com/arki-labs/arki/issues"
  },
  "keywords": [
    "arki",
    "typescript",
    "mcp",
    "model-context-protocol",
    "orpc",
    "dot"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./contract": {
      "types": "./dist/contract.d.ts",
      "import": "./dist/contract.js",
      "default": "./dist/contract.js"
    },
    "./orpc": {
      "types": "./dist/orpc.d.ts",
      "import": "./dist/orpc.js",
      "default": "./dist/orpc.js"
    }
  },
  "files": [
    "dist/**",
    "src/**",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/tests/**",
    "!src/**/test/**",
    "!src/**/__tests__/**",
    "docs/**",
    "README.md",
    "llms.txt",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc -p tsconfig.build.json --watch",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "test": "vitest run",
    "test:runtimes": "arki-runtimes",
    "typecheck": "tsc --noEmit"
  },
  "arki": {
    "runtimes": [
      "node",
      "bun",
      "deno"
    ]
  },
  "dependencies": {
    "@arki/auth": "workspace:*",
    "@arki/failure": "workspace:*",
    "@arki/log": "workspace:*",
    "@arki/schema": "workspace:*",
    "@modelcontextprotocol/server": "catalog:ai",
    "@orpc/client": "catalog:backend",
    "@orpc/contract": "catalog:backend",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@arki/eslint-config": "workspace:*",
    "@arki/library-tooling": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "@modelcontextprotocol/client": "catalog:ai",
    "@orpc/server": "catalog:backend",
    "@types/node": "catalog:node",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "prettier": "@arki/prettier-config"
}
