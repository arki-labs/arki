{
  "name": "@arki/db",
  "version": "0.3.1",
  "description": "Drizzle ORM repositories and database helpers for ARKI — Postgres + PGlite runtimes, projection builder, branded ID factory, and env-aware connection pooling.",
  "keywords": [
    "arki",
    "typescript",
    "drizzle",
    "postgres",
    "pglite",
    "database",
    "orm",
    "projections"
  ],
  "homepage": "https://arki.dev",
  "bugs": {
    "url": "https://github.com/arki-labs/arki/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arki-labs/arki.git",
    "directory": "packages/db"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/init.d.ts",
      "import": "./dist/init.js",
      "default": "./dist/init.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "import": "./dist/env.js",
      "default": "./dist/env.js"
    },
    "./init": {
      "types": "./dist/init.d.ts",
      "bun": {
        "types": "./dist/init.bun.d.ts",
        "import": "./dist/init.bun.js",
        "default": "./dist/init.bun.js"
      },
      "import": "./dist/init.js",
      "default": "./dist/init.js"
    },
    "./factory": {
      "types": "./dist/factory.d.ts",
      "import": "./dist/factory.js",
      "default": "./dist/factory.js"
    },
    "./builder": {
      "types": "./dist/builder.d.ts",
      "import": "./dist/builder.js",
      "default": "./dist/builder.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./runtime-local": {
      "types": "./dist/runtime-local.d.ts",
      "import": "./dist/runtime-local.js",
      "default": "./dist/runtime-local.js"
    },
    "./id": {
      "types": "./dist/id.d.ts",
      "import": "./dist/id.js",
      "default": "./dist/id.js"
    },
    "./id-factory": {
      "types": "./dist/id-factory.d.ts",
      "import": "./dist/id-factory.js",
      "default": "./dist/id-factory.js"
    },
    "./orm": {
      "types": "./dist/orm.d.ts",
      "import": "./dist/orm.js",
      "default": "./dist/orm.js"
    },
    "./pg": {
      "types": "./dist/pg.d.ts",
      "import": "./dist/pg.js",
      "default": "./dist/pg.js"
    },
    "./temporal": {
      "types": "./dist/temporal.d.ts",
      "import": "./dist/temporal.js",
      "default": "./dist/temporal.js"
    },
    "./bun": {
      "types": "./dist/bun.d.ts",
      "import": "./dist/bun.js",
      "default": "./dist/bun.js"
    },
    "./dot": {
      "types": "./dist/dot.d.ts",
      "import": "./dist/dot.js",
      "default": "./dist/dot.js"
    },
    "./migrate": {
      "types": "./dist/migrate.d.ts",
      "import": "./dist/migrate.js",
      "default": "./dist/migrate.js"
    },
    "./pagination": {
      "types": "./dist/pagination.d.ts",
      "import": "./dist/pagination.js",
      "default": "./dist/pagination.js"
    },
    "./transaction": {
      "types": "./dist/transaction.d.ts",
      "import": "./dist/transaction.js",
      "default": "./dist/transaction.js"
    },
    "./orpc": {
      "types": "./dist/orpc.d.ts",
      "import": "./dist/orpc.js",
      "default": "./dist/orpc.js"
    },
    "./eslint": {
      "types": "./dist/eslint.d.ts",
      "import": "./dist/eslint.js",
      "default": "./dist/eslint.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**",
    "src/**",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/*.test-d.ts",
    "!src/**/tests/**",
    "!src/**/test/**",
    "!src/**/__tests__/**",
    "!src/**/__fixtures__/**",
    "README.md",
    "llms.txt",
    "docs/**",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "bench": "bun run build && arki-bench",
    "build": "tsc -p tsconfig.build.json",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc -p tsconfig.build.json --watch",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "test": "vitest run",
    "test:runtimes": "arki-runtimes",
    "typecheck": "tsc --noEmit"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@arki/clock": "workspace:*",
    "@arki/contracts": "workspace:*",
    "@arki/date": "workspace:*",
    "@arki/env": "workspace:*",
    "@arki/log": "workspace:*",
    "@arki/resilience": "workspace:*",
    "@electric-sql/pglite": "catalog:",
    "@paralleldrive/cuid2": "catalog:utilities",
    "@t3-oss/env-core": "catalog:env",
    "drizzle-orm": "catalog:drizzle",
    "pg": "catalog:drizzle",
    "postgres": "catalog:drizzle",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@arki/bench": "workspace:*",
    "@arki/dot": "workspace:*",
    "@arki/eslint-config": "workspace:*",
    "@arki/journal": "workspace:*",
    "@arki/library-tooling": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "@orpc/contract": "catalog:backend",
    "@orpc/server": "catalog:backend",
    "@testcontainers/postgresql": "catalog:testing",
    "@types/bun": "catalog:",
    "@types/node": "catalog:node",
    "@types/pg": "catalog:drizzle",
    "@typescript-eslint/parser": "^8.71.1",
    "@typescript-eslint/rule-tester": "^8.71.1",
    "@typescript-eslint/utils": "^8.71.1",
    "drizzle-kit": "catalog:drizzle",
    "eslint": "catalog:",
    "nanoid": "^6.0.2",
    "p-retry": "^8.0.1",
    "typescript": "catalog:",
    "uuid": "^14.0.3",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@arki/dot": "workspace:*",
    "@orpc/server": "catalog:backend",
    "@typescript-eslint/utils": "^8.0.0",
    "eslint": ">=9.0.0",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@arki/dot": {
      "optional": true
    },
    "@orpc/server": {
      "optional": true
    },
    "@typescript-eslint/utils": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
