{
  "name": "@arki/db",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "main": "./index.ts",
  "types": "./index.ts",
  "scripts": {
    "clean": "rm -rf .turbo node_modules",
    "format": "prettier --check \"**/*.{mjs,ts,md,json}\"",
    "generate:strophie": "drizzle-kit generate:pg --config ./strophie.config.ts",
    "lint": "eslint .",
    "push:strophie": "drizzle-kit push:pg --config ./strophie.config.ts",
    "studio:strophie": "drizzle-kit studio --config ./strophie.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "prettier": "@arki/prettier-config",
  "eslintConfig": {
    "extends": [
      "@arki/eslint-config/base"
    ],
    "root": true
  },
  "dependencies": {
    "@auth/core": "^0.18.0",
    "@paralleldrive/cuid2": "2.2.2",
    "@vercel/postgres": "^0.5.1",
    "drizzle-kit": "^0.19.13",
    "drizzle-orm": "^0.28.6",
    "drizzle-zod": "^0.5.1",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@arki/eslint-config": "workspace:1.0.0",
    "@arki/prettier-config": "workspace:1.0.0",
    "@arki/tsconfig": "workspace:1.0.0",
    "dotenv-cli": "^7.3.0",
    "drizzle-kit": "^0.19.13",
    "eslint": "^8.53.0",
    "prettier": "^3.0.3",
    "typescript": "^5.2.2"
  }
}
