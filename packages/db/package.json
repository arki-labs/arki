{
  "name": "@arki/db",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    "./env": {
      "types": "./dist/src/env.d.ts",
      "import": "./src/env.ts",
      "node": "./src/env.ts"
    },
    "./*": {
      "types": "./dist/src/*.d.ts",
      "import": "./src/*.ts",
      "node": "./src/*.ts"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "*": [
        "src/*"
      ]
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@arki/assert": "workspace:*",
    "@arki/contracts": "workspace:*",
    "@paralleldrive/cuid2": "catalog:utilities",
    "@t3-oss/env-core": "catalog:env",
    "drizzle-orm": "catalog:drizzle",
    "pg": "catalog:drizzle",
    "pg-native": "catalog:drizzle",
    "postgres": "catalog:drizzle",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@arki/eslint-config": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "@types/pg": "catalog:drizzle",
    "typescript": "catalog:"
  }
}
