{
  "name": "@arki/journal",
  "version": "0.4.1",
  "private": false,
  "description": "A journal for Drizzle entities: every change is an immutable event row, the current state is a normal table row, and both are written in one transaction. Inline projections run in the same transaction; effects run after commit from a job table.",
  "keywords": [
    "arki",
    "typescript",
    "journal",
    "events",
    "event-log",
    "drizzle",
    "postgres",
    "projection",
    "jobs"
  ],
  "homepage": "https://arki.dev",
  "bugs": {
    "url": "https://github.com/arki-labs/arki/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arki-labs/arki.git",
    "directory": "packages/journal"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./pg": {
      "types": "./dist/pg.d.ts",
      "import": "./dist/pg.js",
      "default": "./dist/pg.js"
    },
    "./foreman": {
      "types": "./dist/foreman/index.d.ts",
      "import": "./dist/foreman/index.js",
      "default": "./dist/foreman/index.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js",
      "default": "./dist/http.js"
    },
    "./http/webhooks": {
      "types": "./dist/http/webhooks.d.ts",
      "import": "./dist/http/webhooks.js",
      "default": "./dist/http/webhooks.js"
    },
    "./dot": {
      "types": "./dist/dot.d.ts",
      "import": "./dist/dot.js",
      "default": "./dist/dot.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js",
      "default": "./dist/errors.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "import": "./dist/contract.js",
      "default": "./dist/contract.js"
    },
    "./orpc": {
      "types": "./dist/orpc.d.ts",
      "import": "./dist/orpc.js",
      "default": "./dist/orpc.js"
    },
    "./projection": {
      "types": "./dist/projection.d.ts",
      "import": "./dist/projection.js",
      "default": "./dist/projection.js"
    },
    "./event-map": {
      "types": "./dist/event-map.d.ts",
      "import": "./dist/event-map.js",
      "default": "./dist/event-map.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./event-log-contract": {
      "types": "./dist/event-log-contract.d.ts",
      "import": "./dist/event-log-contract.js",
      "default": "./dist/event-log-contract.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "import": "./dist/postgres.js",
      "default": "./dist/postgres.js"
    },
    "./kurrentdb": {
      "types": "./dist/kurrentdb.d.ts",
      "import": "./dist/kurrentdb.js",
      "default": "./dist/kurrentdb.js"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "import": "./dist/zod.js",
      "default": "./dist/zod.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**",
    "src/**",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/__tests__/**",
    "README.md",
    "llms.txt",
    "docs/agent-guide.md",
    "docs/api-reference.md",
    "docs/upgrades/**",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "bench": "bun run build && arki-bench",
    "build": "tsc -p tsconfig.build.json",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc -p tsconfig.build.json --watch",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "test": "vitest run",
    "test:docs": "arki-doc-examples",
    "test:runtimes": "arki-runtimes",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@arki/async": "workspace:*",
    "@arki/contracts": "workspace:*",
    "@arki/db": "workspace:*",
    "@arki/failure": "workspace:*",
    "@arki/log": "workspace:*",
    "@arki/resilience": "workspace:*",
    "@arki/schema": "workspace:*",
    "@opentelemetry/api": "catalog:opentelemetry",
    "drizzle-orm": "catalog:drizzle",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@arki/admin": "workspace:*",
    "@arki/bench": "workspace:*",
    "@arki/dot": "workspace:*",
    "@arki/eslint-config": "workspace:*",
    "@arki/http": "workspace:*",
    "@arki/library-tooling": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "@electric-sql/pglite": "catalog:",
    "@kurrent/kurrentdb-client": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:opentelemetry",
    "@orpc/contract": "catalog:backend",
    "@orpc/server": "catalog:backend",
    "@testcontainers/postgresql": "catalog:testing",
    "@types/node": "catalog:node",
    "@types/pg": "catalog:drizzle",
    "drizzle-kit": "catalog:drizzle",
    "esbuild": "catalog:",
    "pg": "catalog:drizzle",
    "testcontainers": "catalog:testing",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@arki/admin": "workspace:*",
    "@arki/dot": "workspace:*",
    "@arki/http": "workspace:*",
    "@electric-sql/pglite": "catalog:",
    "@kurrent/kurrentdb-client": "catalog:",
    "@orpc/server": "catalog:backend",
    "drizzle-kit": "catalog:drizzle"
  },
  "peerDependenciesMeta": {
    "@arki/admin": {
      "optional": true
    },
    "@arki/dot": {
      "optional": true
    },
    "@arki/http": {
      "optional": true
    },
    "@electric-sql/pglite": {
      "optional": true
    },
    "@kurrent/kurrentdb-client": {
      "optional": true
    },
    "@orpc/server": {
      "optional": true
    },
    "drizzle-kit": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
