{
  "name": "@arki/journal",
  "version": "0.1.1",
  "private": false,
  "description": "A journal for Drizzle entities: every change is an immutable event row, the current state is a normal table row, and both are written in one transaction. Inline projections run in the same transaction; effects run after commit from a job table.",
  "keywords": [
    "arki",
    "typescript",
    "journal",
    "events",
    "event-log",
    "drizzle",
    "postgres",
    "projection",
    "jobs"
  ],
  "homepage": "https://arki.dev",
  "bugs": {
    "url": "https://github.com/arki-labs/arki/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arki-labs/arki.git",
    "directory": "packages/journal"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./pg": {
      "types": "./dist/pg.d.ts",
      "import": "./dist/pg.js",
      "default": "./dist/pg.js"
    },
    "./dot": {
      "types": "./dist/dot.d.ts",
      "import": "./dist/dot.js",
      "default": "./dist/dot.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js",
      "default": "./dist/errors.js"
    },
    "./orpc": {
      "types": "./dist/orpc.d.ts",
      "import": "./dist/orpc.js",
      "default": "./dist/orpc.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**",
    "src/**",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/__tests__/**",
    "README.md",
    "llms.txt",
    "docs/agent-guide.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc -p tsconfig.build.json --watch",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "test": "vitest run",
    "test:runtimes": "arki-runtimes",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@arki/log": "workspace:*",
    "@paralleldrive/cuid2": "catalog:utilities",
    "drizzle-orm": "catalog:drizzle",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@arki/dot": "workspace:*",
    "@arki/eslint-config": "workspace:*",
    "@arki/library-tooling": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "@electric-sql/pglite": "catalog:",
    "@orpc/server": "catalog:backend",
    "@testcontainers/postgresql": "catalog:testing",
    "@types/node": "catalog:node",
    "@types/pg": "catalog:drizzle",
    "drizzle-kit": "catalog:drizzle",
    "pg": "catalog:drizzle"
  },
  "peerDependencies": {
    "@arki/dot": "workspace:*",
    "@electric-sql/pglite": "catalog:",
    "@orpc/server": "catalog:backend",
    "drizzle-kit": "catalog:drizzle"
  },
  "peerDependenciesMeta": {
    "@arki/dot": {
      "optional": true
    },
    "@electric-sql/pglite": {
      "optional": true
    },
    "@orpc/server": {
      "optional": true
    },
    "drizzle-kit": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
