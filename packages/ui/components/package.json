{
  "name": "@arki/ui",
  "version": "0.1.0",
  "exports": {
    "./coming-soon": "./src/coming-soon.tsx",
    "./theme-switcher": "./src/theme-switcher.tsx"
  },
  "typesVersions": {
    "*": {
      "*": [
        "src/*"
      ]
    }
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo node_modules",
