{
  "name": "@arki/icons",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./flags": "./src/flags/index.tsx",
    "./brands": "./src/brands/index.ts",
    "./*": "./src/*.ts"
  },
  "typesVersions": {
    "*": {
      "*": [
        "src/*"
      ]
    }
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@iconify-icon/react": "catalog:",
    "@iconify/json": "catalog:",
    "@iconify/react": "catalog:",
    "@iconify/tailwind4": "catalog:",
    "flag-icons": "catalog:",
    "flagpack-core": "catalog:",
    "lucide-react": "catalog:",
    "react-flagpack": "catalog:",
    "react-icons": "catalog:",
    "simple-icons": "catalog:",
    "unplugin-icons": "catalog:"
  },
  "devDependencies": {
    "@arki/eslint-config": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*"
  },
  "module:jsx": "src"
}
