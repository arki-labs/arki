{
  "name": "@arki/icons",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./src/index.ts",
      "browser": "./src/index.ts"
    },
    "./flags": {
      "types": "./dist/src/flags/index.d.ts",
      "import": "./src/flags/index.tsx",
      "browser": "./src/flags/index.tsx"
    },
    "./brands": {
      "types": "./dist/src/brands/index.d.ts",
      "import": "./src/brands/index.ts",
      "browser": "./src/brands/index.ts"
    },
    "./phosphor": {
      "types": "./dist/src/phosphor.d.ts",
      "import": "./src/phosphor.ts",
      "browser": "./src/phosphor.ts"
    },
    "./phosphor/ssr": {
      "types": "./dist/src/phosphor-ssr.d.ts",
      "import": "./src/phosphor-ssr.ts",
      "browser": "./src/phosphor-ssr.ts"
    },
    "./phosphor/defaults": {
      "types": "./dist/src/phosphor-defaults.d.ts",
      "import": "./src/phosphor-defaults.tsx",
      "browser": "./src/phosphor-defaults.tsx"
    },
    "./*": {
      "types": "./dist/src/*.d.ts",
      "import": "./src/*.ts",
      "browser": "./src/*.ts"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "*": [
        "src/*"
      ]
    }
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "build": "tsc"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@iconify-icon/react": "catalog:",
    "@iconify/json": "catalog:",
    "@iconify/react": "catalog:",
    "@iconify/tailwind4": "catalog:",
    "@phosphor-icons/react": "catalog:",
    "flag-icons": "catalog:",
    "flagpack-core": "catalog:",
    "react-flagpack": "catalog:",
    "react-icons": "catalog:",
    "simple-icons": "catalog:",
    "unplugin-icons": "catalog:"
  },
  "devDependencies": {
    "@arki/eslint-config": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*"
  },
  "module:jsx": "src",
  "types": "./dist/src/index.d.ts",
  "sideEffects": false
}
