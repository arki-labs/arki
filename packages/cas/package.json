{
  "name": "@arki/cas",
  "version": "0.0.2",
  "private": false,
  "description": "A bounded computer algebra package on @arki/expr: exact polynomials and rational functions with π and e as symbolic coefficients, closed-form roots, budgets on every input, and results as canonical expr ASTs.",
  "keywords": [
    "arki",
    "typescript",
    "math",
    "cas",
    "algebra",
    "polynomial",
    "symbolic",
    "roots",
    "simplify",
    "derivative",
    "differentiation"
  ],
  "homepage": "https://arki.dev",
  "bugs": {
    "url": "https://github.com/arki-labs/arki/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arki-labs/arki.git",
    "directory": "packages/cas"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./derivation": {
      "types": "./dist/derivation.d.ts",
      "import": "./dist/derivation.js",
      "default": "./dist/derivation.js"
    },
    "./derivative": {
      "types": "./dist/derivative.d.ts",
      "import": "./dist/derivative.js",
      "default": "./dist/derivative.js"
    },
    "./polynomial": {
      "types": "./dist/polynomial.d.ts",
      "import": "./dist/polynomial.js",
      "default": "./dist/polynomial.js"
    },
    "./simplify": {
      "types": "./dist/simplify.d.ts",
      "import": "./dist/simplify.js",
      "default": "./dist/simplify.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**",
    "src/**",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/__tests__/**",
    "README.md",
    "docs/**",
    "llms.txt",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "bench": "bun run build && arki-bench",
    "build": "tsc -p tsconfig.build.json",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc -p tsconfig.build.json --watch",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "test": "vitest run && size-limit && node scripts/entries.mjs",
    "test:docs": "arki-doc-examples",
    "test:runtimes": "arki-runtimes",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@arki/expr": "workspace:*",
    "@arki/math": "workspace:*"
  },
  "devDependencies": {
    "@arki/bench": "workspace:*",
    "@arki/eslint-config": "workspace:*",
    "@arki/failure": "workspace:*",
    "@arki/library-tooling": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@size-limit/esbuild": "^14.2.0",
    "@size-limit/file": "^14.2.0",
    "algebrite": "^1.4.0",
    "fast-check": "^4.10.2",
    "mathjs": "catalog:",
    "nerdamer": "^2.0.0",
    "size-limit": "^14.2.0",
    "vitest": "catalog:"
  }
}
