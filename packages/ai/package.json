{
  "name": "@arki/ai",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./src/index.ts",
      "node": "./src/index.ts"
    },
    "./react": {
      "types": "./dist/src/react/index.d.ts",
      "import": "./src/react/index.ts",
      "browser": "./src/react/index.ts"
    },
    "./react/*": {
      "types": "./dist/src/react/*.d.ts",
      "import": "./src/react/*.tsx",
      "browser": "./src/react/*.tsx"
    },
    "./*": {
      "types": "./dist/src/*.d.ts",
      "import": "./src/*.ts",
      "node": "./src/*.ts"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "*": [
        "src/*"
      ]
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@ai-sdk/anthropic": "catalog:ai",
    "@ai-sdk/openai": "catalog:ai",
    "@ai-sdk/react": "catalog:ai",
    "@ai-sdk/ui-utils": "catalog:ai",
    "@arki/contracts": "workspace:*",
    "@qdrant/js-client-rest": "catalog:",
    "@t3-oss/env-core": "catalog:env",
    "ai": "catalog:ai",
    "csv-parse": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@arki/eslint-config": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:react",
    "react-dom": "catalog:react"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "types": "./dist/src/index.d.ts",
  "sideEffects": false
}
