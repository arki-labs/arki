{
  "name": "@arki/ai",
  "version": "0.1.3",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./src/index.ts",
      "node": "./src/index.ts"
    },
    "./react": {
      "types": "./dist/src/react/index.d.ts",
      "import": "./src/react/index.ts",
      "browser": "./src/react/index.ts"
    },
    "./react/*": {
      "types": "./dist/src/react/*.d.ts",
      "import": "./src/react/*.tsx",
      "browser": "./src/react/*.tsx"
    },
    "./cost": {
      "types": "./dist/src/cost/index.d.ts",
      "import": "./src/cost/index.ts",
      "node": "./src/cost/index.ts"
    },
    "./safety": {
      "types": "./dist/src/safety/index.d.ts",
      "import": "./src/safety/index.ts",
      "node": "./src/safety/index.ts"
    },
    "./*": {
      "types": "./dist/src/*.d.ts",
      "import": "./src/*.ts",
      "node": "./src/*.ts"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "*": [
        "src/*"
      ]
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "catalog:ai",
    "@ai-sdk/anthropic": "catalog:ai",
    "@ai-sdk/cohere": "catalog:ai",
    "@ai-sdk/google": "catalog:ai",
    "@ai-sdk/groq": "catalog:ai",
    "@ai-sdk/mistral": "catalog:ai",
    "@ai-sdk/openai": "catalog:ai",
    "@ai-sdk/otel": "catalog:ai",
    "@arki/async": "workspace:*",
    "@arki/contracts": "workspace:*",
    "@arki/env": "workspace:*",
    "@arki/failure": "workspace:*",
    "@arki/log": "workspace:*",
    "@arki/schema": "workspace:*",
    "@qdrant/js-client-rest": "catalog:",
    "ai": "catalog:ai",
    "ai-sdk-ollama": "catalog:ai",
    "zod": "catalog:"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/react": {
      "optional": true
    },
    "@huggingface/transformers": {
      "optional": true
    },
    "@mastra/core": {
      "optional": true
    },
    "@mixedbread-ai/sdk": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-markdown": {
      "optional": true
    },
    "remark-gfm": {
      "optional": true
    },
    "streamdown": {
      "optional": true
    },
    "voyageai": {
      "optional": true
    }
  },
  "peerDependencies": {
    "@ai-sdk/react": "catalog:ai",
    "@huggingface/transformers": "*",
    "@mastra/core": "1.37.1",
    "@mixedbread-ai/sdk": "*",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "react-markdown": "catalog:content",
    "remark-gfm": "catalog:content",
    "streamdown": "catalog:ai",
    "voyageai": "*"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.25",
    "@ai-sdk/react": "catalog:ai",
    "@arki/eslint-config": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "@mastra/core": "catalog:",
    "@opentelemetry/api": "catalog:opentelemetry",
    "@opentelemetry/sdk-trace-base": "catalog:opentelemetry",
    "@types/node": "catalog:node",
    "react-markdown": "catalog:content",
    "remark-gfm": "catalog:content",
    "streamdown": "catalog:ai",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "types": "./dist/src/index.d.ts",
  "sideEffects": false
}
