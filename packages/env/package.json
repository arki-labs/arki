{
  "name": "@arki/env",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    "./core": {
      "source": "./src/core/index.ts",
      "import": "./dist/core/index.js",
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./contracts": {
      "source": "./src/contracts/index.ts",
      "import": "./dist/contracts/index.js",
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint ."
  },
  "dependencies": {
    "@arki/contracts": "workspace:*",
    "@t3-oss/env-core": "catalog:env",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@arki/eslint-config": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "typescript": "catalog:"
  },
  "prettier": "@arki/prettier-config"
}
