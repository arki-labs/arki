{
  "name": "@arki/schedule",
  "version": "0.0.1",
  "description": "Typed schedules for TypeScript: cron and interval handlers that run in process or on a durable queue backend, with locks and honest run results.",
  "repository": {
    "type": "git",
    "url": "https://github.com/arki-labs/arki.git",
    "directory": "packages/schedule"
  },
  "license": "MIT",
  "homepage": "https://arki.dev",
  "bugs": {
    "url": "https://github.com/arki-labs/arki/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./src/index.ts",
      "node": "./src/index.ts"
    },
    "./dot": {
      "types": "./dist/src/dot.d.ts",
      "import": "./src/dot.ts",
      "node": "./src/dot.ts"
    },
    "./projection": {
      "types": "./dist/src/projection.d.ts",
      "import": "./src/projection.ts",
      "node": "./src/projection.ts"
    },
    "./runtime": {
      "types": "./dist/src/runtime.d.ts",
      "import": "./src/runtime.ts",
      "node": "./src/runtime.ts"
    },
    "./orpc": {
      "types": "./dist/src/orpc.d.ts",
      "import": "./src/orpc.ts",
      "node": "./src/orpc.ts"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist/**",
    "src/**",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "CHANGELOG.md",
    "README.md",
    "llms.txt",
    "docs/agent-guide.md",
    "docs/recipes/**",
    "docs/reference/**",
    "docs/upgrades/**",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc -p tsconfig.build.json --watch",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "test": "vitest run",
    "test:docs": "arki-doc-examples",
    "typecheck": "tsc --noEmit"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@arki/failure": "workspace:*",
    "@arki/log": "workspace:*",
    "@arki/schema": "workspace:*",
    "@opentelemetry/api": "catalog:opentelemetry",
    "croner": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@arki/db": "workspace:*",
    "@arki/dot": "workspace:*",
    "@arki/eslint-config": "workspace:*",
    "@arki/lock": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "@libsql/client": "^0.18.0",
    "@opentelemetry/sdk-trace-base": "catalog:opentelemetry",
    "@orpc/contract": "catalog:backend",
    "@orpc/openapi": "catalog:backend",
    "@orpc/server": "catalog:backend",
    "@testcontainers/postgresql": "catalog:testing",
    "@types/node": "catalog:node",
    "@types/pg": "catalog:drizzle",
    "drizzle-orm": "catalog:drizzle",
    "pg": "catalog:drizzle",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@arki/dot": "workspace:*",
    "@orpc/contract": "catalog:backend",
    "@orpc/server": "catalog:backend"
  },
  "peerDependenciesMeta": {
    "@arki/dot": {
      "optional": true
    },
    "@orpc/contract": {
      "optional": true
    },
    "@orpc/server": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
