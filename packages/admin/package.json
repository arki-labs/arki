{
  "name": "@arki/admin",
  "version": "0.3.0",
  "private": false,
  "description": "Fleet administration contract for ARKI apps — the shared snapshot schema, app-side request handler, and Foreman-side federation client behind admin.fork.works.",
  "keywords": [
    "arki",
    "typescript",
    "admin",
    "fleet",
    "federation"
  ],
  "homepage": "https://arki.dev",
  "bugs": {
    "url": "https://github.com/arki-labs/arki/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arki-labs/arki.git",
    "directory": "packages/admin"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./src/index.ts",
      "node": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./server": {
      "types": "./dist/src/server.d.ts",
      "node": "./src/server.ts",
      "default": "./src/server.ts"
    },
    "./http": {
      "types": "./dist/src/http.d.ts",
      "node": "./src/http.ts",
      "default": "./src/http.ts"
    },
    "./module": {
      "types": "./dist/src/module.d.ts",
      "import": "./src/module.ts",
      "default": "./src/module.ts"
    },
    "./panels": {
      "types": "./dist/src/panels.d.ts",
      "import": "./src/panels.ts",
      "default": "./src/panels.ts"
    },
    "./pg": {
      "types": "./dist/src/pg.d.ts",
      "import": "./src/pg.ts",
      "default": "./src/pg.ts"
    },
    "./core": {
      "types": "./dist/src/core.d.ts",
      "import": "./src/core.ts",
      "default": "./src/core.ts"
    },
    "./env": {
      "types": "./dist/src/env.d.ts",
      "import": "./src/env.ts",
      "default": "./src/env.ts"
    },
    "./dot": {
      "types": "./dist/src/dot.d.ts",
      "import": "./src/dot.ts",
      "default": "./src/dot.ts"
    },
    "./client": {
      "types": "./dist/src/client.d.ts",
      "import": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./receipts": {
      "types": "./dist/src/receipts.d.ts",
      "import": "./src/receipts.ts",
      "default": "./src/receipts.ts"
    },
    "./connections/coolify": {
      "types": "./dist/src/connections/coolify/index.d.ts",
      "import": "./src/connections/coolify/index.ts",
      "default": "./src/connections/coolify/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**",
    "docs/**",
    "llms.txt",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc --watch",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "test": "vitest run",
    "test:docs": "arki-doc-examples",
    "typecheck": "tsc --noEmit"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@arki/clock": "workspace:*",
    "@arki/contracts": "workspace:*",
    "@arki/failure": "workspace:*",
    "@arki/log": "workspace:*",
    "@arki/schema": "workspace:*",
    "drizzle-orm": "catalog:drizzle",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@arki/dot": "workspace:*",
    "@arki/eslint-config": "workspace:*",
    "@arki/http": "workspace:*",
    "@arki/kv": "workspace:*",
    "@arki/library-tooling": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "@electric-sql/pglite": "catalog:",
    "@types/node": "catalog:node",
    "arktype": "catalog:",
    "drizzle-kit": "catalog:drizzle",
    "typescript": "catalog:",
    "valibot": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@arki/http": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@arki/http": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
