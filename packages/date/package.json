{
  "name": "@arki/date",
  "version": "0.2.0",
  "description": "Date and time math for ARKI — Temporal-based calendar dates, instants, zoned date-times, durations and interval algebra with a small, explicit API. Runs on Node, Bun, Deno, browsers and edge runtimes.",
  "keywords": [
    "arki",
    "typescript",
    "date",
    "time",
    "temporal",
    "duration",
    "interval",
    "timezone",
    "format"
  ],
  "homepage": "https://arki.dev",
  "bugs": {
    "url": "https://github.com/arki-labs/arki/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arki-labs/arki.git",
    "directory": "packages/date"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./interop": {
      "types": "./dist/interop.d.ts",
      "import": "./dist/interop.js",
      "default": "./dist/interop.js"
    },
    "./math": {
      "types": "./dist/math.d.ts",
      "import": "./dist/math.js",
      "default": "./dist/math.js"
    },
    "./calendar": {
      "types": "./dist/calendar.d.ts",
      "import": "./dist/calendar.js",
      "default": "./dist/calendar.js"
    },
    "./compare": {
      "types": "./dist/compare.d.ts",
      "import": "./dist/compare.js",
      "default": "./dist/compare.js"
    },
    "./zone": {
      "types": "./dist/zone.d.ts",
      "import": "./dist/zone.js",
      "default": "./dist/zone.js"
    },
    "./duration": {
      "types": "./dist/duration.d.ts",
      "import": "./dist/duration.js",
      "default": "./dist/duration.js"
    },
    "./interval": {
      "types": "./dist/interval.d.ts",
      "import": "./dist/interval.js",
      "default": "./dist/interval.js"
    },
    "./business": {
      "types": "./dist/business.d.ts",
      "import": "./dist/business.js",
      "default": "./dist/business.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "import": "./dist/format.js",
      "default": "./dist/format.js"
    },
    "./parse": {
      "types": "./dist/parse.d.ts",
      "import": "./dist/parse.js",
      "default": "./dist/parse.js"
    },
    "./relative": {
      "types": "./dist/relative.d.ts",
      "import": "./dist/relative.js",
      "default": "./dist/relative.js"
    },
    "./clock": {
      "types": "./dist/clock.d.ts",
      "import": "./dist/clock.js",
      "default": "./dist/clock.js"
    },
    "./fluent": {
      "types": "./dist/fluent.d.ts",
      "import": "./dist/fluent.js",
      "default": "./dist/fluent.js"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "import": "./dist/zod.js",
      "default": "./dist/zod.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./orpc": {
      "types": "./dist/orpc.d.ts",
      "import": "./dist/orpc.js",
      "default": "./dist/orpc.js"
    },
    "./tanstack": {
      "types": "./dist/tanstack.d.ts",
      "import": "./dist/tanstack.js",
      "default": "./dist/tanstack.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**",
    "src/**",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/tests/**",
    "!src/**/test/**",
    "!src/**/__tests__/**",
    "README.md",
    "LICENSE",
    "llms.txt",
    "docs/**",
    "AGENTS.md",
    "package.json"
  ],
  "scripts": {
    "bench": "bun run build && arki-bench",
    "build": "tsc -p tsconfig.build.json",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc -p tsconfig.build.json --watch",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "test": "vitest run",
    "test:bun": "bun --bun vitest run",
    "test:docs": "arki-doc-examples",
    "test:runtimes": "arki-runtimes",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false && tsc -p examples/tsconfig.json"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@arki/clock": "workspace:*",
    "temporal-polyfill": "catalog:utilities"
  },
  "devDependencies": {
    "@arki/bench": "workspace:*",
    "@arki/eslint-config": "workspace:*",
    "@arki/library-tooling": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "@orpc/client": "catalog:backend",
    "@orpc/server": "catalog:backend",
    "@tanstack/react-router": "catalog:tanstack/start",
    "@tanstack/router-core": "^1.171.34",
    "@testing-library/react": "catalog:testing",
    "@types/react": "catalog:react",
    "date-fns": "catalog:utilities",
    "dayjs": "^1.11.23",
    "jsdom": "catalog:text-processing",
    "luxon": "^3.7.2",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "seroval": "^1.6.8",
    "superjson": "catalog:utilities",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@orpc/client": "catalog:backend",
    "@tanstack/react-router": "catalog:tanstack/start",
    "react": "catalog:react",
    "superjson": "catalog:utilities",
    "zod": "catalog:"
  },
  "peerDependenciesMeta": {
    "@orpc/client": {
      "optional": true
    },
    "@tanstack/react-router": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "superjson": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
