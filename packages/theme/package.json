{
  "name": "@arki/theme",
  "version": "0.2.1",
  "description": "Light / dark / system theme provider and no-flash init script for ARKI React apps.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arki-labs/arki.git"
  },
  "homepage": "https://arki.dev",
  "bugs": {
    "url": "https://github.com/arki-labs/arki/issues"
  },
  "keywords": [
    "arki",
    "typescript",
    "react",
    "theme",
    "dark-mode"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./src/index.ts",
      "browser": "./src/index.ts"
    },
    "./script": {
      "types": "./dist/src/script.d.ts",
      "import": "./src/script.ts"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist/**",
    "!dist/**/*.spec.*",
    "!dist/**/*.test.*",
    "src/**",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/tests/**",
    "!src/**/test/**",
    "!src/**/__tests__/**",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "peerDependencies": {
    "react": "19.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
