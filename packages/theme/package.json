{
  "name": "@arki/theme",
  "version": "0.2.1",
  "description": "Light / dark / system theme provider and no-flash init script for ARKI React apps.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arki-labs/arki.git",
    "directory": "packages/theme"
  },
  "homepage": "https://arki.dev",
  "bugs": {
    "url": "https://github.com/arki-labs/arki/issues"
  },
  "keywords": [
    "arki",
    "typescript",
    "react",
    "theme",
    "dark-mode"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "private": false,
  "files": [
    "dist/**",
    "!dist/**/*.spec.*",
    "!dist/**/*.test.*",
    "src/**",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/tests/**",
    "!src/**/test/**",
    "!src/**/__tests__/**",
    "docs/agent-guide.md",
    "llms.txt",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./src/index.ts",
      "browser": "./src/index.ts"
    },
    "./script": {
      "types": "./dist/src/script.d.ts",
      "import": "./src/script.ts"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "bench": "bun run build && arki-bench",
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "test": "vitest run --configLoader runner",
    "test:docs": "arki-doc-examples",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "prettier": "@arki/prettier-config",
  "peerDependencies": {
    "react": "catalog:react"
  },
  "devDependencies": {
    "@arki/bench": "workspace:*",
    "@arki/eslint-config": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "@testing-library/react": "catalog:testing",
    "@types/node": "catalog:node",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "catalog:text-processing",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "vitest": "catalog:"
  }
}
