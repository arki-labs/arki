      "node": "./src/index.ts"
    },
    "./assertions": {
      "types": "./dist/src/assertions.d.ts",
      "import": "./src/assertions.ts",
      "node": "./src/assertions.ts"
    },
    "./containers": {
      "types": "./dist/src/containers.d.ts",
      "import": "./src/containers.ts",
      "node": "./src/containers.ts"
    },
    "./debug": {
      "types": "./dist/src/debug.d.ts",
      "import": "./src/debug.ts",
      "node": "./src/debug.ts"
    },
    "./factories": {
      "types": "./dist/src/factories.d.ts",
      "import": "./src/factories.ts",
      "node": "./src/factories.ts"
    },
    "./integration-tester": {
      "types": "./dist/src/integration-tester.d.ts",
      "import": "./src/integration-tester.ts",
      "node": "./src/integration-tester.ts"
    },
    "./msw": {
      "types": "./dist/src/msw.d.ts",
      "import": "./src/msw.ts",
      "node": "./src/msw.ts"
    },
    "./performance": {
      "types": "./dist/src/performance.d.ts",
      "import": "./src/performance.ts",
      "node": "./src/performance.ts"
    },
    "./tester-builder": {
      "types": "./dist/src/tester-builder.d.ts",
      "import": "./src/tester-builder.ts",
      "node": "./src/tester-builder.ts"
    },
    "./timestamps": {
      "types": "./dist/src/timestamps.d.ts",
      "import": "./src/timestamps.ts",
      "node": "./src/timestamps.ts"
    },
    "./types": {
      "types": "./dist/src/types.d.ts",
      "import": "./src/types.ts",
      "node": "./src/types.ts"
    },
    "./vitest-setup": {
      "types": "./dist/src/vitest-setup.d.ts",
      "import": "./src/vitest-setup.ts",
      "node": "./src/vitest-setup.ts"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@arki/auth": "workspace:*",
    "@arki/date": "workspace:*",
    "@arki/db": "workspace:*",
    "@arki/kv": "workspace:*",
    "@arki/log": "workspace:*",
    "@faker-js/faker": "catalog:testing",
    "@testcontainers/postgresql": "catalog:testing",
    "@testcontainers/redis": "catalog:testing",
    "drizzle-orm": "catalog:drizzle",
    "msw": "catalog:testing",
    "testcontainers": "catalog:testing",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@arki/eslint-config": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "vitest": "catalog:"
  }
