{
  "name": "@arki/testing",
  "version": "0.1.0",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./src/index.ts",
      "node": "./src/index.ts"
    },
    "./*": {
      "types": "./dist/src/*.d.ts",
      "import": "./src/*.ts",
      "node": "./src/*.ts"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@arki/auth": "workspace:*",
    "@arki/db": "workspace:*",
    "@arki/kv": "workspace:*",
    "@faker-js/faker": "catalog:testing",
    "@testcontainers/postgresql": "catalog:testing",
    "@testcontainers/redis": "catalog:testing",
    "drizzle-orm": "catalog:drizzle",
    "testcontainers": "catalog:testing"
  },
  "devDependencies": {
    "@arki/eslint-config": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*"
  }
}
