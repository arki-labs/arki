{
  "name": "@arki/testing",
  "version": "0.2.0",
  "description": "Test tooling for TypeScript backends: testcontainers Postgres and Redis, an integration tester, typed factories, assertions, MSW mocking and AI judges.",
  "keywords": [
    "arki",
    "typescript",
    "testing",
    "vitest",
    "testcontainers",
    "msw",
    "playwright"
  ],
  "homepage": "https://arki.dev",
  "bugs": {
    "url": "https://github.com/arki-labs/arki/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arki-labs/arki.git",
    "directory": "packages/testing"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ai": {
      "types": "./dist/ai/index.d.ts",
      "import": "./dist/ai/index.js",
      "default": "./dist/ai/index.js"
    },
    "./ai/playwright": {
      "types": "./dist/ai/playwright.d.ts",
      "import": "./dist/ai/playwright.js",
      "default": "./dist/ai/playwright.js"
    },
    "./ai/vitest": {
      "types": "./dist/ai/vitest.d.ts",
      "import": "./dist/ai/vitest.js",
      "default": "./dist/ai/vitest.js"
    },
    "./assertions": {
      "types": "./dist/assertions.d.ts",
      "import": "./dist/assertions.js",
      "default": "./dist/assertions.js"
    },
    "./containers": {
      "types": "./dist/containers.d.ts",
      "import": "./dist/containers.js",
      "default": "./dist/containers.js"
    },
    "./debug": {
      "types": "./dist/debug.d.ts",
      "import": "./dist/debug.js",
      "default": "./dist/debug.js"
    },
    "./factories": {
      "types": "./dist/factories.d.ts",
      "import": "./dist/factories.js",
      "default": "./dist/factories.js"
    },
    "./e2e": {
      "types": "./dist/e2e/index.d.ts",
      "import": "./dist/e2e/index.js",
      "default": "./dist/e2e/index.js"
    },
    "./services/http-fixtures": {
      "types": "./dist/services/http-fixtures.d.ts",
      "import": "./dist/services/http-fixtures.js",
      "default": "./dist/services/http-fixtures.js"
    },
    "./services/mailpit": {
      "types": "./dist/services/mailpit.d.ts",
      "import": "./dist/services/mailpit.js",
      "default": "./dist/services/mailpit.js"
    },
    "./services/ollama": {
      "types": "./dist/services/ollama.d.ts",
      "import": "./dist/services/ollama.js",
      "default": "./dist/services/ollama.js"
    },
    "./services/postgres": {
      "types": "./dist/services/postgres.d.ts",
      "import": "./dist/services/postgres.js",
      "default": "./dist/services/postgres.js"
    },
    "./services/redis": {
      "types": "./dist/services/redis.d.ts",
      "import": "./dist/services/redis.js",
      "default": "./dist/services/redis.js"
    },
    "./stack": {
      "types": "./dist/stack/index.d.ts",
      "import": "./dist/stack/index.js",
      "default": "./dist/stack/index.js"
    },
    "./stack/contract": {
      "types": "./dist/stack/contract.d.ts",
      "import": "./dist/stack/contract.js",
      "default": "./dist/stack/contract.js"
    },
    "./server/integration-tester": {
      "types": "./dist/integration-tester.d.ts",
      "import": "./dist/integration-tester.js",
      "default": "./dist/integration-tester.js"
    },
    "./msw": {
      "types": "./dist/msw.d.ts",
      "import": "./dist/msw.js",
      "default": "./dist/msw.js"
    },
    "./performance": {
      "types": "./dist/performance.d.ts",
      "import": "./dist/performance.js",
      "default": "./dist/performance.js"
    },
    "./server/tester-builder": {
      "types": "./dist/tester-builder.d.ts",
      "import": "./dist/tester-builder.js",
      "default": "./dist/tester-builder.js"
    },
    "./timestamps": {
      "types": "./dist/timestamps.d.ts",
      "import": "./dist/timestamps.js",
      "default": "./dist/timestamps.js"
    },
    "./vitest-setup": {
      "types": "./dist/vitest-setup.d.ts",
      "import": "./dist/vitest-setup.js",
      "default": "./dist/vitest-setup.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**",
    "src/**",
    "!src/**/*.test.ts",
    "!src/**/*.spec.ts",
    "!src/**/__fixtures__/**",
    "!src/**/*.calibration.test.ts",
    "docs/agent-guide.md",
    "docs/*.md",
    "docs/recipes/**",
    "llms.txt",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc -p tsconfig.build.json --watch",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "test": "vitest run",
    "test:docs": "arki-doc-examples",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@arki/date": "workspace:*",
    "@arki/db": "workspace:*",
    "@arki/failure": "workspace:*",
    "@arki/kv": "workspace:*",
    "@arki/log": "workspace:*",
    "@arki/schema": "workspace:*",
    "@faker-js/faker": "catalog:testing",
    "drizzle-orm": "catalog:drizzle",
    "pg": "catalog:drizzle"
  },
  "devDependencies": {
    "@arki/auth": "workspace:*",
    "@arki/eslint-config": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "@playwright/test": "catalog:testing",
    "@testcontainers/postgresql": "catalog:testing",
    "@testcontainers/redis": "catalog:testing",
    "@types/pg": "catalog:drizzle",
    "arktype": "catalog:",
    "msw": "catalog:testing",
    "testcontainers": "catalog:testing",
    "valibot": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@arki/auth": "workspace:*",
    "@playwright/test": "catalog:testing",
    "@testcontainers/postgresql": "catalog:testing",
    "@testcontainers/redis": "catalog:testing",
    "msw": "catalog:testing",
    "testcontainers": "catalog:testing",
    "vitest": "catalog:"
  },
  "peerDependenciesMeta": {
    "@arki/auth": {
      "optional": true
    },
    "@playwright/test": {
      "optional": true
    },
    "@testcontainers/postgresql": {
      "optional": true
    },
    "@testcontainers/redis": {
      "optional": true
    },
    "msw": {
      "optional": true
    },
    "testcontainers": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
