/* The workbench theme: fonts, semantic tokens (light and dark) and the Tailwind
   bridge that maps them onto classes (bg-background, text-primary, ...).
   @arki/ui reads these standard shadcn token names. Edit the values freely. */

/* ─── WORKBENCH — Web Fonts ────────────────────────────────────
   Loaded via @fontsource (self-hosted, no CDN).
   Import this file before tokens.css in your global stylesheet.
   ─────────────────────────────────────────────────────────────── */

/* Body text — calm, modern variable sans for product UI */
@import '@fontsource-variable/work-sans';

/* Code — technical monospace with tabular figures */
@import '@fontsource/ibm-plex-mono/400.css';
@import '@fontsource/ibm-plex-mono/500.css';
@import '@fontsource/ibm-plex-mono/700.css';

/* Display — high-contrast editorial serif, used intentionally */
@import '@fontsource/instrument-serif/400.css';
@import '@fontsource/instrument-serif/400-italic.css';

/* ─── CSS Custom Properties ─── */
:root {
  --font-sans: 'Work Sans Variable', ui-sans-serif, system-ui, sans-serif;
  --font-mono: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
  --font-serif: 'Instrument Serif', ui-serif, Georgia, serif;
}

/* ═══════════════════════════════════════════════════════════════
   WORKBENCH DESIGN SYSTEM — Tokens
   "The notebook workbench" — editorial, calm, study-first aesthetic

   Warm paper foundations, monochrome text hierarchy, subtle pastel
   accents, calm structural rhythm for learning/product pages.

   Type scale: inherits Tailwind v4 defaults (16px base; ratios
   are pragmatic, not strict 1.25×). Future systems may opt into
   stricter mathematical scales via overrides.

   Border radius: 0.375rem (6px) — sharper than atelier's 12px,
   matching the calm utility character.

   Depth strategy: borders-prominent + minimal lift. Workbench leans
   on borders (--border) to define regions and uses subtle, neutral
   shadows only where genuine elevation is needed.
   ═══════════════════════════════════════════════════════════════ */


/* ─── LIGHT MODE — Paper neutrals with ink contrast ─── */
:root {
  --heading-font: 'Plus Jakarta Sans Variable', ui-sans-serif, system-ui, sans-serif;
  --font-sans: 'Work Sans Variable', ui-sans-serif, system-ui, sans-serif;
  --font-mono: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
  --font-serif: 'Instrument Serif', ui-serif, Georgia, serif;
  --background: hsl(36 14% 96%);
  --foreground: hsl(24 9% 10%);
  --card: hsl(36 18% 97%);
  --card-foreground: hsl(24 9% 10%);
  --popover: hsl(36 18% 97%);
  --popover-foreground: hsl(24 9% 10%);
  --primary: hsl(24 8% 8%);
  --primary-foreground: hsl(0 0% 100%);
  --secondary: hsl(36 12% 92%);
  --secondary-foreground: hsl(24 9% 16%);
  --muted: hsl(36 10% 91%);
  --muted-foreground: hsl(24 6% 40%);
  --accent: hsl(200 53% 89%);
  --accent-foreground: hsl(24 9% 14%);
  --destructive: hsl(0 69% 46%);
  --destructive-foreground: hsl(0 0% 100%);
  --destructive-surface: hsl(0 55% 94%);
  --success: hsl(152 60% 24%);
  --success-surface: hsl(152 35% 92%);
  --warning: hsl(38 85% 26%);
  --warning-surface: hsl(48 70% 90%);
  --info: hsl(225 60% 40%);
  --info-surface: hsl(225 60% 94%);
  --border: hsl(36 10% 84%);
  --input: hsl(36 10% 54%);
  --ring: hsl(24 8% 8%);
  --chart-1: hsl(225 66% 63%);
  --chart-2: hsl(334 61% 66%);
  --chart-3: hsl(48 76% 60%);
  --chart-4: hsl(133 33% 82%);
  --chart-5: hsl(24 9% 14%);
  --radius: 0.375rem;

  /* Workbench depth — borders-prominent + minimal neutral lift */
  --shadow-sm: 0 1px 2px 0 hsl(24 9% 10% / 0.04);
  --shadow-md:
    0 0 0 1px hsl(36 10% 84% / 0.5),
    0 1px 3px hsl(24 9% 10% / 0.05);
  --shadow-lg:
    0 0 0 1px hsl(36 10% 84% / 0.5),
    0 4px 12px hsl(24 9% 10% / 0.08);

  --sidebar-background: hsl(36 14% 95%);
  --sidebar-foreground: hsl(24 9% 12%);
  --sidebar-primary: hsl(24 8% 8%);
  --sidebar-primary-foreground: hsl(0 0% 100%);
  --sidebar-accent: hsl(36 12% 91%);
  --sidebar-accent-foreground: hsl(24 8% 18%);
  --sidebar-border: hsl(36 9% 84%);
  --sidebar-ring: hsl(24 8% 8%);
}

/* ─── DARK MODE — Warm charcoal notebook ─── */
.dark {
  --background: hsl(24 9% 8%);
  --foreground: hsl(36 18% 91%);
  --card: hsl(24 9% 11%);
  --card-foreground: hsl(36 18% 91%);
  --popover: hsl(24 9% 11%);
  --popover-foreground: hsl(36 18% 91%);
  --primary: hsl(36 18% 92%);
  --primary-foreground: hsl(24 10% 8%);
  --secondary: hsl(24 8% 16%);
  --secondary-foreground: hsl(36 17% 90%);
  --muted: hsl(24 7% 16%);
  --muted-foreground: hsl(24 8% 68.5%);
  --accent: hsl(215 35% 28%);
  --accent-foreground: hsl(36 18% 92%);
  --destructive: hsl(0 61% 63%);
  --destructive-foreground: hsl(0 0% 14%);
  --destructive-surface: hsl(0 28% 16%);
  --success: hsl(152 50% 62%);
  --success-surface: hsl(152 22% 15%);
  --warning: hsl(48 78% 68%);
  --warning-surface: hsl(48 35% 15%);
  --info: hsl(225 70% 76%);
  --info-surface: hsl(225 30% 17%);
  --border: hsl(24 7% 24%);
  --input: hsl(24 7% 38.5%);
  --ring: hsl(36 18% 92%);
  --chart-1: hsl(225 70% 72%);
  --chart-2: hsl(334 68% 74%);
  --chart-3: hsl(48 78% 68%);
  --chart-4: hsl(133 36% 68%);
  --chart-5: hsl(36 18% 92%);

  /* Dark-mode depth — pseudo-borders + minimal lift via 1px ring at low opacity */
  --shadow-sm: 0 1px 2px 0 hsl(0 0% 0% / 0.30);
  --shadow-md:
    0 0 0 1px hsl(36 18% 92% / 0.06),
    0 1px 3px hsl(0 0% 0% / 0.32);
  --shadow-lg:
    0 0 0 1px hsl(36 18% 92% / 0.06),
    0 4px 12px hsl(0 0% 0% / 0.36);

  --sidebar-background: hsl(24 9% 8%);
  --sidebar-foreground: hsl(36 18% 91%);
  --sidebar-primary: hsl(36 18% 92%);
  --sidebar-primary-foreground: hsl(24 10% 8%);
  --sidebar-accent: hsl(24 8% 16%);
  --sidebar-accent-foreground: hsl(36 18% 91%);
  --sidebar-border: hsl(24 7% 24%);
  --sidebar-ring: hsl(36 18% 92%);
}

/* ═══════════════════════════════════════════════════════════════
   WORKBENCH DESIGN SYSTEM — Tailwind v4 Theme Bridge

   Maps CSS custom properties to Tailwind's --color-* namespace
   so semantic classes (bg-primary, text-muted-foreground, etc.)
   resolve correctly. Import this in your app's global.css after
   importing tailwindcss.
   ═══════════════════════════════════════════════════════════════ */

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --color-card: var(--card);
  --color-card-foreground: var(--card-foreground);
  --color-popover: var(--popover);
  --color-popover-foreground: var(--popover-foreground);
  --color-primary: var(--primary);
  --color-primary-foreground: var(--primary-foreground);
  --color-secondary: var(--secondary);
  --color-secondary-foreground: var(--secondary-foreground);
  --color-muted: var(--muted);
  --color-muted-foreground: var(--muted-foreground);
  --color-accent: var(--accent);
  --color-accent-foreground: var(--accent-foreground);
  --color-destructive: var(--destructive);
  --color-destructive-foreground: var(--destructive-foreground);
  --color-destructive-surface: var(--destructive-surface);
  --color-success: var(--success);
  --color-success-surface: var(--success-surface);
  --color-warning: var(--warning);
  --color-warning-surface: var(--warning-surface);
  --color-info: var(--info);
  --color-info-surface: var(--info-surface);
  --color-border: var(--border);
  --color-input: var(--input);
  --color-ring: var(--ring);
  --color-chart-1: var(--chart-1);
  --color-chart-2: var(--chart-2);
  --color-chart-3: var(--chart-3);
  --color-chart-4: var(--chart-4);
  --color-chart-5: var(--chart-5);

  --color-sidebar: var(--sidebar-background);
  --color-sidebar-foreground: var(--sidebar-foreground);
  --color-sidebar-primary: var(--sidebar-primary);
  --color-sidebar-primary-foreground: var(--sidebar-primary-foreground);
  --color-sidebar-accent: var(--sidebar-accent);
  --color-sidebar-accent-foreground: var(--sidebar-accent-foreground);
  --color-sidebar-border: var(--sidebar-border);
  --color-sidebar-ring: var(--sidebar-ring);

  --radius-sm: calc(var(--radius) - 4px);
  --radius-md: calc(var(--radius) - 2px);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) + 4px);

  /* Shadow tokens — Workbench uses borders-prominent + minimal lift for utility/study feel */
  --shadow-sm: var(--shadow-sm);
  --shadow-md: var(--shadow-md);
  --shadow-lg: var(--shadow-lg);

  --font-family-sans: var(--font-sans);
  --font-family-mono: var(--font-mono);
  --font-family-serif: var(--font-serif);

  /* Workbench stays at 200ms for snappier, utility-focused transitions */
  --animate-accordion-down: accordion-down 0.2s ease-out;
  --animate-accordion-up: accordion-up 0.2s ease-out;

  @keyframes accordion-down {
    from {
      height: 0;
    }
    to {
      height: var(--radix-accordion-content-height);
    }
  }

  @keyframes accordion-up {
    from {
      height: var(--radix-accordion-content-height);
    }
    to {
      height: 0;
    }
  }
}

/* ─── Reduced-motion guarantee ─────────────────────────────────
   Hard-rule per workspace accessibility contract: any surface
   importing this design system honors prefers-reduced-motion.
   Apps may still add app-level animations; this catches them.
   ─────────────────────────────────────────────────────────────── */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

/* ─── Scrollbar styling ────────────────────────────────────────
   Workspace-wide thin, theme-aware scrollbar. Uses --border so
   it follows light/dark mode automatically. Sits in @layer base
   so any unlayered per-app override wins via cascade.
   ─────────────────────────────────────────────────────────────── */
@layer base {
  ::-webkit-scrollbar {
    width: 5px;
  }
  ::-webkit-scrollbar-track {
    background: transparent;
  }
  ::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: 5px;
  }

  * {
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }
}
