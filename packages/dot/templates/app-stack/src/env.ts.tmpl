import { z } from 'zod';

/**
 * Env vars the app validates at boot (through `env()` from `@arki/env/dot`).
 * Add a key here, then read it from `services.env` in a plugin.
 *
 * `DB_URL` is not listed: the `db` plugin from `@arki/db/dot` reads and
 * checks it itself. Logging reads `LOG_LEVEL` and `DEBUG` (see `src/app.ts`).
 */
export const envSchema = {
  NODE_ENV: z.enum(['development', 'test', 'production']).default('development'),
};
