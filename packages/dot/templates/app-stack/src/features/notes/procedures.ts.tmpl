import { ORPCError } from '@orpc/server';
import { z } from 'zod';

import { errorMap, orThrowRpc } from '@arki/failure/orpc';
import { COMMAND_FAILURES } from '@arki/journal';

import { procedure } from '~/server/orpc';

import { createNote, createNoteInput } from './note';
import { notesRepository } from './repository';
import { noteId } from './tables';

export const notesRouter = {
  list: procedure
    .input(z.object({ limit: z.int().min(1).max(100).default(50) }).default({ limit: 50 }))
    .handler(({ context, input }) => notesRepository(context.db).list(input.limit)),

  byId: procedure.input(z.object({ id: noteId.schema })).handler(async ({ context, input }) => {
    const found = await notesRepository(context.db).findById(input.id);
    if (!found) throw new ORPCError('NOT_FOUND', { message: 'Note not found.' });
    return found;
  }),

  // The command returns its failures as values. `orThrowRpc` answers each one
  // with the typed oRPC error the `errors` map declares, so the client gets it typed.
  create: procedure
    .errors(errorMap(...COMMAND_FAILURES))
    .input(createNoteInput)
    .handler(({ context, input, errors }) => orThrowRpc(context.run(createNote, input), errors)),
};
