@import 'tailwindcss';

/* The workbench theme: fonts, tokens, and the bridge that maps tokens onto
   Tailwind (bg-background, text-primary, ...). */
@import './workbench.css';

/* Tailwind must see the classes used inside @arki/ui components. */
@source '../node_modules/@arki/ui/src';

@custom-variant dark (&:is(.dark *));
