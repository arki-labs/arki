import { createAppRuntime } from '@arki/dot/runtime';

import { app, dev } from '~/app';

import type { RpcContext } from './orpc';

/**
 * The started DOT app: one per server process. Boot runs migrations, then
 * the journal worker starts; SIGTERM / SIGINT drain it. A failed start is not
 * cached, so a database that comes up late does not need a restart.
 *
 * `dot dev` sets `DOT_DEV=1` and gets `dev` (embedded PGlite); everything
 * else runs `app` (Postgres from `DB_URL`). Both come from one `createApp`,
 * so their services have the same shape. On a hot update the old app is
 * disposed before the new one starts, so two apps never share the database.
 */
const runtime = createAppRuntime(process.env['DOT_DEV'] === '1' ? dev : app, { hot: import.meta.hot });

/** The started app, started on first use. */
export function startApp() {
  return runtime.get();
}

/** The oRPC context for one request. There is no sign-in yet, so writes have no actor. */
export async function createRpcContext(): Promise<RpcContext> {
  const { services } = await startApp();
  return {
    db: services.db,
    run: services.journal.bind(services.db, { actorId: null }),
  };
}
