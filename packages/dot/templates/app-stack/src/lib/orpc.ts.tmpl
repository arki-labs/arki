import type { RouterClient } from '@orpc/server';
import { createORPCClient } from '@orpc/client';
import { RPCLink } from '@orpc/client/fetch';
import { createTanstackQueryUtils } from '@orpc/tanstack-query';

import type { AppRouter } from '~/server/router';

const link = new RPCLink({
  // Resolved per call, in the browser: queries run client-side.
  url: () => new URL('/api/rpc', window.location.origin),
});

const client: RouterClient<AppRouter> = createORPCClient(link);

/**
 * Typed TanStack Query helpers for the API:
 *
 *   useQuery(orpc.notes.list.queryOptions({ input: {} }))
 *   useMutation(orpc.notes.create.mutationOptions())
 */
export const orpc = createTanstackQueryUtils(client);
