# Production image for {{name}}.
#
#   docker build -t {{name}} .
#   docker run -p 3000:3000 -e DB_URL=postgres://... {{name}}
#
# Every stage uses the official musl Bun image. Never copy a Bun binary from
# a glibc image into Alpine: it crashes on start.

# ---- deps: install packages from the lockfile ----
FROM oven/bun:1-alpine AS deps
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

# ---- build: compile the app into .output/ ----
FROM deps AS build
COPY . .
ENV NODE_ENV=production \
  NITRO_PRESET=bun
RUN bun --bun run build

# ---- runner: only the server bundle and the migrations ----
FROM oven/bun:1-alpine AS runner
RUN apk add --no-cache curl tini
WORKDIR /app
COPY --from=build --chown=bun:bun /app/.output ./.output
# Applied on boot by the dbMigrations plugin (src/app.ts reads ./drizzle).
COPY --from=build --chown=bun:bun /app/drizzle ./drizzle
USER bun
ENV NODE_ENV=production \
  PORT=3000 \
  HOST=0.0.0.0
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -fsS --max-time 4 http://localhost:3000/api/health || exit 1
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["bun", ".output/server/index.mjs"]
