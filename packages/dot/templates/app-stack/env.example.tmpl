# Copy to .env: `cp .env.example .env`. Bun loads .env for `bun run ...`.

# Postgres connection. Matches docker-compose.yml.
DB_URL=postgres://app:app@localhost:5432/app

# Log level: trace, debug, info, warn, error, fatal.
LOG_LEVEL=info

# Turn on debug logs for some categories, e.g. DEBUG=app:*,arki:journal:*
DEBUG=
