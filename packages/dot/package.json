{
  "name": "@arki/dot",
  "version": "0.1.1",
  "description": "TypeScript-first application composition framework for the ARKI package family — lifecycle-aware pips, deterministic boot order, manifest/diagnostics envelopes, and an agent-native CLI. A DOT app is the sum of its pips.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/arki-labs/arki.git",
    "directory": "packages/dot"
  },
  "homepage": "https://arki.dev/dot",
  "bugs": {
    "url": "https://github.com/arki-labs/arki/issues"
  },
  "keywords": [
    "arki",
    "typescript",
    "framework",
    "pip",
    "pips",
    "lifecycle",
    "diagnostics",
    "manifest",
    "agent-native",
    "dot"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "bin": {
    "dot": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./pip": {
      "types": "./dist/pip.d.ts",
      "import": "./dist/pip.js",
      "default": "./dist/pip.js"
    },
    "./package.json": "./package.json",
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./src/cli/index.ts",
      "default": "./dist/cli/index.js"
    },
    "./test-harness": {
      "types": "./dist/test-harness.d.ts",
      "import": "./src/test-harness.ts",
      "default": "./dist/test-harness.js"
    }
  },
  "files": [
    "dist/**",
    "templates/**",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc -p tsconfig.build.json --watch",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@arki/assert": "workspace:*",
    "@arki/contracts": "workspace:*",
    "@arki/log": "workspace:*",
    "@opentelemetry/api": "catalog:opentelemetry",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@arki/eslint-config": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "@opentelemetry/sdk-trace-base": "catalog:opentelemetry",
    "@types/node": "catalog:node",
    "typescript": "catalog:"
  }
}
