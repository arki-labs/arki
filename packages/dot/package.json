{
  "name": "@arki/dot",
  "version": "0.6.0",
  "description": "TypeScript-first application composition framework for the ARKI package family \u2014 lifecycle-aware plugins, deterministic boot order, manifest/diagnostics envelopes, and an agent-native CLI. A DOT app is the sum of its plugins.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/arki-labs/arki.git",
    "directory": "packages/dot"
  },
  "homepage": "https://arki.dev/dot",
  "bugs": {
    "url": "https://github.com/arki-labs/arki/issues"
  },
  "keywords": [
    "arki",
    "typescript",
    "framework",
    "plugin",
    "plugins",
    "lifecycle",
    "diagnostics",
    "manifest",
    "agent-native",
    "dot"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "bin": {
    "dot": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    },
    "./feature": {
      "types": "./dist/feature.d.ts",
      "import": "./dist/feature.js",
      "default": "./dist/feature.js"
    },
    "./package.json": "./package.json",
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js",
      "default": "./dist/cli/index.js"
    },
    "./log": {
      "types": "./dist/log.d.ts",
      "import": "./dist/log.js",
      "default": "./dist/log.js"
    },
    "./test-harness": {
      "types": "./dist/test-harness.d.ts",
      "import": "./dist/test-harness.js",
      "default": "./dist/test-harness.js"
    }
  },
  "files": [
    "dist/**",
    "src/**",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/tests/**",
    "!src/**/test/**",
    "!src/**/__tests__/**",
    "templates/**",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "bench": "bun run build && arki-bench",
    "build": "tsc -p tsconfig.build.json",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc -p tsconfig.build.json --watch",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@arki/contracts": "workspace:*",
    "@arki/log": "workspace:*",
    "@opentelemetry/api": "catalog:opentelemetry",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@arki/bench": "workspace:*",
    "@arki/eslint-config": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "@opentelemetry/sdk-trace-base": "catalog:opentelemetry",
    "@types/node": "catalog:node",
    "awilix": "^13.0.5",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
