{
  "name": "@arki/dot",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./src/index.ts",
      "node": "./src/index.ts"
    },
    "./*": {
      "types": "./dist/src/*.d.ts",
      "import": "./src/*.ts",
      "node": "./src/*.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "build": "tsc"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@arki/assert": "workspace:*",
    "@arki/auth": "workspace:*",
    "@arki/contracts": "workspace:*",
    "@arki/db": "workspace:*",
    "@arki/emails": "workspace:*",
    "@arki/event-sourcing": "workspace:*",
    "@arki/fs": "workspace:*",
    "@arki/kv": "workspace:*",
    "@arki/logger": "workspace:*",
    "@arki/slugify": "workspace:*",
    "@t3-oss/env-core": "catalog:env",
    "@trpc/client": "catalog:trpc",
    "@trpc/server": "catalog:trpc",
    "better-auth": "catalog:better-auth",
    "drizzle-orm": "catalog:drizzle",
    "superjson": "catalog:utilities",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@arki/eslint-config": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "typescript": "catalog:"
  },
  "types": "./dist/src/index.d.ts",
  "sideEffects": false
}
