{
  "name": "@arki/mail",
  "version": "0.2.0",
  "description": "Typed mail for TypeScript: Standard Schema templates, honest transports, quota failover, and mail that commits with your transaction.",
  "repository": {
    "type": "git",
    "url": "https://github.com/arki-labs/arki.git",
    "directory": "packages/mail"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./templates/auth": {
      "types": "./dist/templates/auth.d.ts",
      "import": "./dist/templates/auth.js",
      "default": "./dist/templates/auth.js"
    },
    "./http/resend": {
      "types": "./dist/http/resend.d.ts",
      "import": "./dist/http/resend.js",
      "default": "./dist/http/resend.js"
    },
    "./http/mailpit": {
      "types": "./dist/http/mailpit.d.ts",
      "import": "./dist/http/mailpit.js",
      "default": "./dist/http/mailpit.js"
    },
    "./http/unosend": {
      "types": "./dist/http/unosend.d.ts",
      "import": "./dist/http/unosend.js",
      "default": "./dist/http/unosend.js"
    },
    "./http/cloudflare": {
      "types": "./dist/http/cloudflare.d.ts",
      "import": "./dist/http/cloudflare.js",
      "default": "./dist/http/cloudflare.js"
    },
    "./node/ses": {
      "types": "./dist/node/ses.d.ts",
      "import": "./dist/node/ses.js",
      "default": "./dist/node/ses.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    },
    "./react/templates/magic-link": {
      "types": "./dist/react/templates/magic-link.d.ts",
      "import": "./dist/react/templates/magic-link.js",
      "default": "./dist/react/templates/magic-link.js"
    },
    "./react/templates/magic-link-minimal": {
      "types": "./dist/react/templates/magic-link-minimal.d.ts",
      "import": "./dist/react/templates/magic-link-minimal.js",
      "default": "./dist/react/templates/magic-link-minimal.js"
    },
    "./pg": {
      "types": "./dist/pg/index.d.ts",
      "import": "./dist/pg/index.js",
      "default": "./dist/pg/index.js"
    },
    "./pg/testing": {
      "types": "./dist/pg/testing.d.ts",
      "import": "./dist/pg/testing.js",
      "default": "./dist/pg/testing.js"
    },
    "./dot": {
      "types": "./dist/dot.d.ts",
      "import": "./dist/dot.js",
      "default": "./dist/dot.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**",
    "src/**",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "docs/agent-guide.md",
    "llms.txt",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc -p tsconfig.build.json --watch",
    "export": "bun run email export --dir src/react/templates",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "studio": "bun run email dev --dir src/react/templates --port 3333",
    "test": "vitest run",
    "test:docs": "arki-doc-examples",
    "test:runtimes": "arki-runtimes",
    "typecheck": "tsc --noEmit"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@arki/failure": "workspace:*",
    "@arki/log": "workspace:*",
    "@arki/schema": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@arki/dot": "workspace:*",
    "@arki/eslint-config": "workspace:*",
    "@arki/journal": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/resilience": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "@aws-sdk/client-sesv2": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "@react-email/render": "catalog:react-email",
    "@types/node": "catalog:node",
    "arktype": "catalog:",
    "drizzle-kit": "catalog:drizzle",
    "drizzle-orm": "catalog:drizzle",
    "react": "catalog:react",
    "react-email": "catalog:",
    "valibot": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@arki/dot": "workspace:*",
    "@arki/journal": "workspace:*",
    "@arki/resilience": "workspace:*",
    "@aws-sdk/client-sesv2": "^3",
    "@react-email/render": "catalog:react-email",
    "drizzle-orm": "catalog:drizzle",
    "react": "^18 || ^19",
    "react-email": "^6",
    "vitest": "catalog:"
  },
  "peerDependenciesMeta": {
    "@arki/dot": {
      "optional": true
    },
    "@arki/journal": {
      "optional": true
    },
    "@arki/resilience": {
      "optional": true
    },
    "@aws-sdk/client-sesv2": {
      "optional": true
    },
    "@react-email/render": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-email": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
