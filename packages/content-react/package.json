{
  "name": "@arki/content-react",
  "version": "0.1.0",
  "description": "React components for content: MDX renderer, article, changelog and timeline views, code blocks, GitHub and tweet embeds, and a post search hook.",
  "keywords": [
    "arki",
    "react",
    "mdx",
    "content",
    "components"
  ],
  "homepage": "https://arki.dev",
  "bugs": {
    "url": "https://github.com/arki-labs/arki/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arki-labs/arki.git",
    "directory": "packages/content-react"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**",
    "src/**",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/*.stories.*",
    "!src/**/tests/**",
    "!src/**/test/**",
    "!src/**/__tests__/**",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc -p tsconfig.build.json --watch",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "test:docs": "arki-doc-examples",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "test": "vitest run --configLoader runner"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@arki/content": "workspace:*",
    "@arki/date": "workspace:*",
    "@arki/failure": "workspace:*",
    "@arki/icons": "workspace:*",
    "@arki/intl": "workspace:*",
    "@arki/math": "workspace:*",
    "@arki/schema": "workspace:*",
    "@arki/ui": "workspace:*",
    "@content-collections/mdx": "catalog:next",
    "nuqs": "catalog:",
    "react-tweet": "catalog:",
    "rehype-react": "catalog:content",
    "remark-parse": "catalog:content",
    "remark-rehype": "catalog:content",
    "unified": "catalog:",
    "use-intl": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@arki/eslint-config": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "@testing-library/react": "catalog:testing",
    "@types/react": "catalog:react",
    "@vitejs/plugin-react": "catalog:",
    "@types/react-dom": "catalog:react",
    "jsdom": "catalog:text-processing",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "publishConfig": {
    "access": "public"
  },
  "arki": {
    "bundlerOnly": [
      "."
    ]
  }
}
