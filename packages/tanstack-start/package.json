{
  "name": "@arki/tanstack-start",
  "version": "0.2.0",
  "private": false,
  "description": "TanStack Start wiring for Arki apps: router and query client defaults, the server entry, typed oRPC client utils and hooks, PWA, devtools and error pages.",
  "keywords": [
    "arki",
    "typescript",
    "tanstack",
    "tanstack-start",
    "tanstack-router",
    "tanstack-query",
    "orpc",
    "pwa",
    "react"
  ],
  "homepage": "https://arki.dev",
  "bugs": {
    "url": "https://github.com/arki-labs/arki/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arki-labs/arki.git",
    "directory": "packages/tanstack-start"
  },
  "license": "MIT",
  "sideEffects": [
    "./dist/src/pwa/sw.js"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "browser": "./dist/src/index.js"
    },
    "./config": {
      "types": "./dist/src/app.config.d.ts",
      "import": "./dist/src/app.config.js",
      "node": "./dist/src/app.config.js"
    },
    "./vite": {
      "types": "./dist/src/vite.d.ts",
      "default": "./dist/src/vite.js"
    },
    "./server": {
      "types": "./dist/src/start-server.d.ts",
      "import": "./dist/src/start-server.js",
      "node": "./dist/src/start-server.js"
    },
    "./dot": {
      "types": "./dist/src/dot.d.ts",
      "import": "./dist/src/dot.js",
      "node": "./dist/src/dot.js"
    },
    "./router": {
      "types": "./dist/src/router.d.ts",
      "import": "./dist/src/router.js",
      "browser": "./dist/src/router.js"
    },
    "./orpc/client": {
      "types": "./dist/src/orpc/client.d.ts",
      "import": "./dist/src/orpc/client.js",
      "browser": "./dist/src/orpc/client.js"
    },
    "./orpc/query": {
      "types": "./dist/src/orpc/query.d.ts",
      "import": "./dist/src/orpc/query.js",
      "browser": "./dist/src/orpc/query.js"
    },
    "./orpc/server": {
      "types": "./dist/src/orpc/server.d.ts",
      "import": "./dist/src/orpc/server.js",
      "node": "./dist/src/orpc/server.js"
    },
    "./scripts": {
      "types": "./dist/src/scripts.d.ts",
      "import": "./dist/src/scripts.js",
      "browser": "./dist/src/scripts.js"
    },
    "./error": {
      "types": "./dist/src/error.d.ts",
      "import": "./dist/src/error.js",
      "browser": "./dist/src/error.js"
    },
    "./devtools": {
      "types": "./dist/src/devtools.d.ts",
      "import": "./dist/src/devtools.js",
      "browser": "./dist/src/devtools.js"
    },
    "./sentry/client": {
      "types": "./dist/src/sentry-client.d.ts",
      "import": "./dist/src/sentry-client.js",
      "browser": "./dist/src/sentry-client.js"
    },
    "./sentry/server": {
      "types": "./dist/src/sentry-server.d.ts",
      "import": "./dist/src/sentry-server.js",
      "node": "./dist/src/sentry-server.js"
    },
    "./sentry/bridge": {
      "types": "./dist/src/sentry-bridge.d.ts",
      "import": "./dist/src/sentry-bridge.js",
      "default": "./dist/src/sentry-bridge.js"
    },
    "./server-error-overlay": {
      "types": "./dist/src/server-error-overlay.d.ts",
      "import": "./dist/src/server-error-overlay.js",
      "node": "./dist/src/server-error-overlay.js"
    },
    "./pwa": {
      "types": "./dist/src/pwa/index.d.ts",
      "default": "./dist/src/pwa/index.js"
    },
    "./pwa/sw": {
      "types": "./dist/src/pwa/sw.d.ts",
      "import": "./dist/src/pwa/sw.js",
      "browser": "./dist/src/pwa/sw.js"
    },
    "./pwa/client": {
      "types": "./dist/src/pwa/client.d.ts",
      "import": "./dist/src/pwa/client.js",
      "browser": "./dist/src/pwa/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc --watch",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "test": "vitest run",
    "test:docs": "arki-doc-examples",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@arki/contracts": "workspace:*",
    "@arki/failure": "workspace:*",
    "@arki/icons": "workspace:*",
    "@arki/log": "workspace:*",
    "@arki/schema": "workspace:*",
    "@arki/ui": "workspace:*",
    "@orpc/client": "catalog:backend",
    "@orpc/contract": "catalog:backend",
    "@orpc/server": "catalog:backend",
    "@orpc/tanstack-query": "catalog:backend",
    "@sentry/core": "^11.6.0",
    "@tanstack/react-devtools": "catalog:tanstack/start",
    "@tanstack/react-query": "catalog:tanstack/react-query",
    "@tanstack/react-query-devtools": "catalog:tanstack/react-query",
    "@tanstack/react-router": "catalog:tanstack/start",
    "@tanstack/react-router-devtools": "catalog:tanstack/start",
    "@tanstack/react-start": "catalog:tanstack/start",
    "@unpic/react": "catalog:tanstack/start",
    "@vitejs/plugin-react": "catalog:",
    "jotai": "catalog:",
    "jotai-devtools": "catalog:",
    "superjson": "catalog:utilities",
    "vite": "catalog:build-tools",
    "vite-plugin-pwa": "catalog:tanstack/start",
    "workbox-precaching": "catalog:tanstack/start",
    "workbox-routing": "catalog:tanstack/start",
    "workbox-strategies": "catalog:tanstack/start",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@arki/dot": "workspace:*",
    "@arki/eslint-config": "workspace:*",
    "@arki/library-tooling": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/schedule": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "@orpc/openapi": "catalog:backend",
    "@sentry/node": "catalog:",
    "@sentry/react": "catalog:",
    "@sentry/tanstackstart-react": "catalog:",
    "@testing-library/react": "catalog:testing",
    "@types/bun": "catalog:",
    "@types/node": "catalog:node",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "jsdom": "catalog:text-processing",
    "nitro": "catalog:tanstack/start",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@arki/dot": "workspace:*",
    "@arki/schedule": "workspace:*",
    "@orpc/openapi": "catalog:backend",
    "@sentry/node": "catalog:",
    "@sentry/react": "catalog:",
    "@sentry/tanstackstart-react": "catalog:",
    "nitro": "catalog:tanstack/start",
    "react": "catalog:react",
    "react-dom": "catalog:react"
  },
  "peerDependenciesMeta": {
    "@arki/dot": {
      "optional": true
    },
    "@arki/schedule": {
      "optional": true
    },
    "@orpc/openapi": {
      "optional": true
    },
    "@sentry/node": {
      "optional": true
    },
    "@sentry/react": {
      "optional": true
    },
    "@sentry/tanstackstart-react": {
      "optional": true
    },
    "nitro": {
      "optional": true
    }
  }
}
