{
  "name": "@arki/tanstack-start",
  "version": "0.1.1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./src/index.ts",
      "browser": "./src/index.ts"
    },
    "./config": {
      "types": "./dist/src/app.config.d.ts",
      "import": "./src/app.config.ts",
      "node": "./src/app.config.ts"
    },
    "./server": {
      "types": "./dist/src/server.d.ts",
      "import": "./src/server.ts",
      "node": "./src/server.ts"
    },
    "./router": {
      "types": "./dist/src/router.d.ts",
      "import": "./src/router.ts",
      "browser": "./src/router.ts"
    },
    "./orpc/client": {
      "types": "./dist/src/orpc/client.d.ts",
      "import": "./src/orpc/client.ts",
      "browser": "./src/orpc/client.ts"
    },
    "./orpc/server": {
      "types": "./dist/src/orpc/server.d.ts",
      "import": "./src/orpc/server.ts",
      "node": "./src/orpc/server.ts"
    },
    "./seo": {
      "types": "./dist/src/seo.d.ts",
      "import": "./src/seo.ts",
      "browser": "./src/seo.ts"
    },
    "./scripts": {
      "types": "./dist/src/scripts.d.ts",
      "import": "./src/scripts.ts",
      "browser": "./src/scripts.ts"
    },
    "./error": {
      "types": "./dist/src/error.d.ts",
      "import": "./src/error.tsx",
      "browser": "./src/error.tsx"
    },
    "./devtools": {
      "types": "./dist/src/devtools.d.ts",
      "import": "./src/devtools.tsx",
      "browser": "./src/devtools.tsx"
    },
    "./sentry/client": {
      "types": "./dist/src/sentry-client.d.ts",
      "import": "./src/sentry-client.ts",
      "browser": "./src/sentry-client.ts"
    },
    "./sentry/server": {
      "types": "./dist/src/sentry-server.d.ts",
      "import": "./src/sentry-server.ts",
      "node": "./src/sentry-server.ts"
    },
    "./sentry/bridge": {
      "types": "./dist/src/sentry-bridge.d.ts",
      "import": "./src/sentry-bridge.ts",
      "default": "./src/sentry-bridge.ts"
    },
    "./server-error-overlay": {
      "types": "./dist/src/server-error-overlay.d.ts",
      "import": "./src/server-error-overlay.ts",
      "node": "./src/server-error-overlay.ts"
    },
    "./pwa": {
      "types": "./dist/src/pwa/index.d.ts",
      "default": "./dist/src/pwa/index.js"
    },
    "./pwa/sw": {
      "types": "./dist/src/pwa/sw.d.ts",
      "import": "./src/pwa/sw.ts",
      "browser": "./src/pwa/sw.ts"
    },
    "./pwa/client": {
      "types": "./dist/src/pwa/client.d.ts",
      "import": "./src/pwa/client.ts",
      "browser": "./src/pwa/client.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.pwa.json",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc --watch",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@arki/content": "workspace:*",
    "@arki/icons": "workspace:*",
    "@arki/intl": "workspace:*",
    "@arki/meter": "workspace:*",
    "@arki/ts": "workspace:*",
    "@orpc/client": "catalog:backend",
    "@orpc/server": "catalog:backend",
    "@orpc/tanstack-query": "catalog:backend",
    "@tanstack/react-devtools": "catalog:tanstack/start",
    "@tanstack/react-query": "catalog:tanstack/react-query",
    "@tanstack/react-query-devtools": "catalog:tanstack/react-query",
    "@tanstack/react-router": "catalog:tanstack/start",
    "@tanstack/react-router-devtools": "catalog:tanstack/start",
    "@tanstack/react-start": "catalog:tanstack/start",
    "@tanstack/start-vite-plugin": "catalog:tanstack/start",
    "@unpic/react": "catalog:tanstack/start",
    "jotai-devtools": "catalog:",
    "nitropack": "catalog:tanstack/start",
    "superjson": "catalog:utilities",
    "vite": "catalog:build-tools",
    "vite-plugin-pwa": "catalog:tanstack/start",
    "workbox-precaching": "catalog:tanstack/start",
    "workbox-routing": "catalog:tanstack/start",
    "workbox-strategies": "catalog:tanstack/start"
  },
  "peerDependencies": {
    "@sentry/node": "catalog:",
    "@sentry/react": "catalog:",
    "@sentry/tanstackstart-react": "catalog:",
    "react": "catalog:react",
    "react-dom": "catalog:react"
  },
  "peerDependenciesMeta": {
    "@sentry/node": {
      "optional": true
    },
    "@sentry/react": {
      "optional": true
    },
    "@sentry/tanstackstart-react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arki/eslint-config": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@sentry/node": "catalog:",
    "@sentry/react": "catalog:",
    "@sentry/tanstackstart-react": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:node",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "@vitejs/plugin-react": "catalog:"
  },
  "sideEffects": [
    "./src/pwa/sw.ts",
    "./dist/src/pwa/sw.js"
  ]
}
