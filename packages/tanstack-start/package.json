{
  "name": "@arki/tanstack-start",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./src/index.ts",
      "browser": "./src/index.ts"
    },
    "./config": {
      "types": "./dist/src/app.config.d.ts",
      "import": "./src/app.config.ts",
      "node": "./src/app.config.ts"
    },
    "./server": {
      "types": "./dist/src/server.d.ts",
      "import": "./src/server.ts",
      "node": "./src/server.ts"
    },
    "./router": {
      "types": "./dist/src/router.d.ts",
      "import": "./src/router.ts",
      "browser": "./src/router.ts"
    },
    "./trpc/client": {
      "types": "./dist/src/trpc/client.d.ts",
      "import": "./src/trpc/client.ts",
      "browser": "./src/trpc/client.ts"
    },
    "./trpc/server": {
      "types": "./dist/src/trpc/server.d.ts",
      "import": "./src/trpc/server.ts",
      "node": "./src/trpc/server.ts"
    },
    "./seo": {
      "types": "./dist/src/seo.d.ts",
      "import": "./src/seo.ts",
      "browser": "./src/seo.ts"
    },
    "./scripts": {
      "types": "./dist/src/scripts.d.ts",
      "import": "./src/scripts.ts",
      "browser": "./src/scripts.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc --watch",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@arki/content": "workspace:*",
    "@arki/icons": "workspace:*",
    "@arki/intl": "workspace:*",
    "@arki/meter": "workspace:*",
    "@arki/ts": "workspace:*",
    "@tanstack/react-query": "catalog:tanstack/react-query",
    "@tanstack/react-query-devtools": "catalog:tanstack/react-query",
    "@tanstack/react-router": "catalog:tanstack/start",
    "@tanstack/react-start": "catalog:tanstack/start",
    "@tanstack/start-vite-plugin": "catalog:tanstack/start",
    "@trpc/client": "catalog:trpc",
    "@trpc/react-query": "catalog:trpc",
    "@trpc/server": "catalog:trpc",
    "@trpc/tanstack-react-query": "catalog:trpc",
    "@unpic/react": "catalog:tanstack/start",
    "nitropack": "catalog:tanstack/start",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "superjson": "catalog:utilities",
    "vite": "catalog:build-tools",
    "vite-tsconfig-paths": "catalog:tanstack/start"
  },
  "devDependencies": {
    "@arki/eslint-config": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react"
  },
  "sideEffects": false
}
