{
  "name": "@arki/emails",
  "private": true,
  "version": "0.1.2",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./src/index.ts",
      "node": "./src/index.ts",
      "browser": "./src/index.ts"
    },
    "./send": {
      "types": "./dist/src/send.d.ts",
      "import": "./src/send.ts",
      "node": "./src/send.ts",
      "browser": "./src/send.ts"
    },
    "./client": {
      "types": "./dist/src/client/init.d.ts",
      "import": "./src/client/init.ts",
      "node": "./src/client/init.ts"
    },
    "./providers/resend": {
      "types": "./dist/src/providers/resend.d.ts",
      "import": "./src/providers/resend.ts",
      "node": "./src/providers/resend.ts"
    },
    "./providers/unosend": {
      "types": "./dist/src/providers/unosend.d.ts",
      "import": "./src/providers/unosend.ts",
      "node": "./src/providers/unosend.ts"
    },
    "./providers/ses": {
      "types": "./dist/src/providers/ses.d.ts",
      "import": "./src/providers/ses.ts",
      "node": "./src/providers/ses.ts"
    },
    "./providers/cloudflare-email-service": {
      "types": "./dist/src/providers/cloudflare-email-service.d.ts",
      "import": "./src/providers/cloudflare-email-service.ts",
      "node": "./src/providers/cloudflare-email-service.ts"
    },
    "./providers/quota-router": {
      "types": "./dist/src/providers/quota-router.d.ts",
      "import": "./src/providers/quota-router.ts",
      "node": "./src/providers/quota-router.ts"
    },
    "./providers/quota-store-kv": {
      "types": "./dist/src/providers/quota-store-kv.d.ts",
      "import": "./src/providers/quota-store-kv.ts",
      "node": "./src/providers/quota-store-kv.ts"
    },
    "./templates/arki-magic-link": {
      "types": "./dist/src/templates/arki-magic-link.d.ts",
      "import": "./src/templates/arki-magic-link.tsx",
      "node": "./src/templates/arki-magic-link.tsx",
      "browser": "./src/templates/arki-magic-link.tsx"
    },
    "./templates/notion-magic-link": {
      "types": "./dist/src/templates/notion-magic-link.d.ts",
      "import": "./src/templates/notion-magic-link.tsx",
      "node": "./src/templates/notion-magic-link.tsx",
      "browser": "./src/templates/notion-magic-link.tsx"
    },
    "./templates/plaid-verify-identity": {
      "types": "./dist/src/templates/plaid-verify-identity.d.ts",
      "import": "./src/templates/plaid-verify-identity.tsx",
      "node": "./src/templates/plaid-verify-identity.tsx",
      "browser": "./src/templates/plaid-verify-identity.tsx"
    },
    "./templates/stripe-welcome": {
      "types": "./dist/src/templates/stripe-welcome.d.ts",
      "import": "./src/templates/stripe-welcome.tsx",
      "node": "./src/templates/stripe-welcome.tsx",
      "browser": "./src/templates/stripe-welcome.tsx"
    },
    "./templates/vercel-invite-user": {
      "types": "./dist/src/templates/vercel-invite-user.d.ts",
      "import": "./src/templates/vercel-invite-user.tsx",
      "node": "./src/templates/vercel-invite-user.tsx",
      "browser": "./src/templates/vercel-invite-user.tsx"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/src/index.d.ts",
  "typesVersions": {
    "*": {
      "send": [
        "src/send.ts"
      ],
      "client": [
        "src/client/init.ts"
      ],
      "providers/resend": [
        "src/providers/resend.ts"
      ],
      "providers/unosend": [
        "src/providers/unosend.ts"
      ],
      "providers/ses": [
        "src/providers/ses.ts"
      ],
      "providers/cloudflare-email-service": [
        "src/providers/cloudflare-email-service.ts"
      ],
      "providers/quota-router": [
        "src/providers/quota-router.ts"
      ],
      "providers/quota-store-kv": [
        "src/providers/quota-store-kv.ts"
      ],
      "templates/arki-magic-link": [
        "src/templates/arki-magic-link.tsx"
      ],
      "templates/notion-magic-link": [
        "src/templates/notion-magic-link.tsx"
      ],
      "templates/plaid-verify-identity": [
        "src/templates/plaid-verify-identity.tsx"
      ],
      "templates/stripe-welcome": [
        "src/templates/stripe-welcome.tsx"
      ],
      "templates/vercel-invite-user": [
        "src/templates/vercel-invite-user.tsx"
      ]
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "export": "bun run email export --dir src/templates",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "studio": "bun run email dev --dir src/templates --port 3333",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@arki/contracts": "workspace:*",
    "@arki/log": "workspace:*",
    "@aws-sdk/client-sesv2": "catalog:",
    "@react-email/render": "catalog:react-email",
    "react-email": "catalog:",
    "resend": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@arki/eslint-config": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "@types/node": "catalog:node",
    "react": "catalog:react",
    "vitest": "catalog:"
  },
  "module:jsx": "src",
  "peerDependencies": {
    "react": "^18 || ^19"
  }
}
