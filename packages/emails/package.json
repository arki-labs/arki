{
  "name": "@arki/emails",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./send": "./src/send.ts",
    "./templates/*": "./src/templates/*.tsx"
  },
  "typesVersions": {
    "*": {
      "*": [
        "src/*"
      ]
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "email dev",
    "export": "email export",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@react-email/body": "0.0.11",
    "@react-email/button": "0.0.19",
    "@react-email/column": "^0.0.13",
    "@react-email/container": "^0.0.15",
    "@react-email/font": "^0.0.9",
    "@react-email/head": "^0.0.12",
    "@react-email/heading": "^0.0.15",
    "@react-email/hr": "^0.0.11",
    "@react-email/html": "^0.0.11",
    "@react-email/img": "^0.0.11",
    "@react-email/link": "^0.0.12",
    "@react-email/markdown": "^0.0.14",
    "@react-email/preview": "^0.0.12",
    "@react-email/row": "^0.0.12",
    "@react-email/section": "^0.0.16",
    "@react-email/tailwind": "^1.0.3",
    "@react-email/text": "^0.0.11",
    "resend": "^4.0.1"
  },
  "devDependencies": {
    "@arki/eslint-config": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*"
  },
  "module:jsx": "src"
}
