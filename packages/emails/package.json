{
  "name": "@arki/emails",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./src/index.ts",
      "browser": "./src/index.ts"
    },
    "./send": {
      "types": "./dist/src/send.d.ts",
      "import": "./src/send.ts",
      "browser": "./src/send.ts"
    },
    "./templates/*": {
      "types": "./dist/src/templates/*.d.ts",
      "import": "./src/templates/*.tsx",
      "browser": "./src/templates/*.tsx"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "*": [
        "src/*"
      ]
    }
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "export": "pnpm email export --dir src/templates",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "studio": "pnpm email dev --dir src/templates --port 3333",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "build": "tsc"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@react-email/body": "catalog:react-email",
    "@react-email/button": "catalog:react-email",
    "@react-email/column": "catalog:react-email",
    "@react-email/container": "catalog:react-email",
    "@react-email/font": "catalog:react-email",
    "@react-email/head": "catalog:react-email",
    "@react-email/heading": "catalog:react-email",
    "@react-email/hr": "catalog:react-email",
    "@react-email/html": "catalog:react-email",
    "@react-email/img": "catalog:react-email",
    "@react-email/link": "catalog:react-email",
    "@react-email/markdown": "catalog:react-email",
    "@react-email/preview": "catalog:react-email",
    "@react-email/row": "catalog:react-email",
    "@react-email/section": "catalog:react-email",
    "@react-email/tailwind": "catalog:react-email",
    "@react-email/text": "catalog:react-email",
    "resend": "catalog:"
  },
  "devDependencies": {
    "@arki/eslint-config": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "react-email": "catalog:"
  },
  "module:jsx": "src",
  "types": "./dist/src/index.d.ts",
  "sideEffects": false
}
