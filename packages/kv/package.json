{
  "name": "@arki/kv",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts",
      "types": "./dist/index.d.ts"
    },
    "./env": {
      "default": "./src/env.ts",
      "types": "./dist/env.d.ts"
    },
    "./*": {
      "default": "./src/*.ts",
      "types": "./dist/*.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@arki/contracts": "workspace:*",
    "@arki/logger": "workspace:*",
    "@keyv/redis": "catalog:backend",
    "@t3-oss/env-core": "catalog:env",
    "ioredis": "catalog:",
    "keyv": "catalog:backend",
    "rate-limiter-flexible": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@arki/eslint-config": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*"
  }
}
