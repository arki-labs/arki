{
  "name": "@arki/kv",
  "version": "0.2.1",
  "description": "Key-value store abstraction with pluggable adapters for ARKI \u2014 Redis-backed Keyv client and rate-limiter with TLS auto-detection and Upstash support.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/arki-labs/arki.git",
    "directory": "packages/kv"
  },
  "homepage": "https://arki.dev",
  "bugs": {
    "url": "https://github.com/arki-labs/arki/issues"
  },
  "keywords": [
    "arki",
    "typescript",
    "kv",
    "key-value",
    "redis",
    "keyv",
    "rate-limit",
    "cache"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "import": "./dist/env.js",
      "default": "./dist/env.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js",
      "default": "./dist/errors.js"
    },
    "./instance": {
      "types": "./dist/instance.d.ts",
      "import": "./dist/instance.js",
      "default": "./dist/instance.js"
    },
    "./redis/idempotency": {
      "types": "./dist/redis/idempotency.d.ts",
      "import": "./dist/redis/idempotency.js",
      "default": "./dist/redis/idempotency.js"
    },
    "./dot": {
      "types": "./dist/dot.d.ts",
      "import": "./dist/dot.js",
      "default": "./dist/dot.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**",
    "src/**",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/tests/**",
    "!src/**/test/**",
    "!src/**/__tests__/**",
    "README.md",
    "docs/**",
    "llms.txt",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "bench": "bun run build && arki-bench",
    "build": "tsc -p tsconfig.build.json",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc -p tsconfig.build.json --watch",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "test": "vitest run",
    "test:docs": "arki-doc-examples",
    "typecheck": "tsc --noEmit"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@arki/contracts": "workspace:*",
    "@arki/env": "workspace:*",
    "@arki/log": "workspace:*",
    "@arki/schema": "workspace:*",
    "@arki/ts": "workspace:*",
    "@keyv/redis": "catalog:backend",
    "@t3-oss/env-core": "catalog:env",
    "ioredis": "catalog:",
    "keyv": "catalog:backend",
    "rate-limiter-flexible": "catalog:",
    "@arki/failure": "workspace:*"
  },
  "peerDependencies": {
    "@arki/dot": "workspace:*",
    "@arki/http": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@arki/dot": {
      "optional": true
    },
    "@arki/http": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arki/bench": "workspace:*",
    "@arki/dot": "workspace:*",
    "@arki/eslint-config": "workspace:*",
    "@arki/http": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "@testcontainers/redis": "catalog:testing",
    "@types/node": "catalog:node",
    "typescript": "catalog:",
    "unstorage": "^1.17.5",
    "vitest": "catalog:"
  }
}
