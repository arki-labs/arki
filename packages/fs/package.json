{
  "name": "@arki/fs",
  "version": "0.1.0",
  "exports": {
    "./*": "./src/*.ts"
  },
  "typesVersions": {
    "*": {
      "*": [
        "src/*"
      ]
    }
  },
  "scripts": {
    "clean": "rm -rf .turbo node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "prettier": "@arki/prettier-config",
  "eslintConfig": {
    "extends": [
      "@arki/eslint-config/base"
    ],
    "root": true
  },
  "dependencies": {
    "del": "^7.1.0",
    "iconv-lite": "^0.6.3"
  },
  "devDependencies": {
    "@arki/eslint-config": "workspace:^0.1.0",
    "@arki/prettier-config": "workspace:^0.1.0",
    "@arki/tsconfig": "workspace:^0.1.0",
    "@arki/vitest-config": "workspace:^0.1.0",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3"
  }
}
