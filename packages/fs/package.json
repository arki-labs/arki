    },
    "./local/delete": {
      "types": "./dist/src/local/delete.d.ts",
      "import": "./src/local/delete.ts",
      "node": "./src/local/delete.ts"
    },
    "./local/dir": {
      "types": "./dist/src/local/dir.d.ts",
      "import": "./src/local/dir.ts",
      "node": "./src/local/dir.ts"
    },
    "./local/glob": {
      "types": "./dist/src/local/glob.d.ts",
      "import": "./src/local/glob.ts",
      "node": "./src/local/glob.ts"
    },
    "./local/read-file": {
      "types": "./dist/src/local/read-file.d.ts",
      "import": "./src/local/read-file.ts",
      "node": "./src/local/read-file.ts"
    },
    "./local/read-first-line": {
      "types": "./dist/src/local/read-first-line.d.ts",
      "import": "./src/local/read-first-line.ts",
      "node": "./src/local/read-first-line.ts"
    },
    "./local/write": {
      "types": "./dist/src/local/write.d.ts",
      "import": "./src/local/write.ts",
      "node": "./src/local/write.ts"
    },
    "./s3": {
      "types": "./dist/src/s3.d.ts",
      "import": "./src/s3.ts",
      "node": "./src/s3.ts"
    },
    "./storage": {
      "types": "./dist/src/storage/index.d.ts",
      "import": "./src/storage/index.ts",
