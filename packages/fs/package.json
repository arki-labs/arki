{
  "name": "@arki/fs",
  "version": "0.1.3",
  "description": "File storage for ARKI: local, S3 and R2 adapters, a files table with upload lifecycle, and typed failures returned as values.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/arki-labs/arki.git",
    "directory": "packages/fs"
  },
  "homepage": "https://arki.dev",
  "bugs": {
    "url": "https://github.com/arki-labs/arki/issues"
  },
  "keywords": [
    "arki",
    "typescript",
    "fs",
    "storage",
    "s3",
    "r2",
    "files",
    "upload"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    "./env": {
      "types": "./dist/src/env.d.ts",
      "import": "./dist/src/env.js",
      "default": "./dist/src/env.js"
    },
    "./local/delete": {
      "types": "./dist/src/local/delete.d.ts",
      "import": "./dist/src/local/delete.js",
      "default": "./dist/src/local/delete.js"
    },
    "./local/dir": {
      "types": "./dist/src/local/dir.d.ts",
      "import": "./dist/src/local/dir.js",
      "default": "./dist/src/local/dir.js"
    },
    "./local/glob": {
      "types": "./dist/src/local/glob.d.ts",
      "import": "./dist/src/local/glob.js",
      "default": "./dist/src/local/glob.js"
    },
    "./local/read-file": {
      "types": "./dist/src/local/read-file.d.ts",
      "import": "./dist/src/local/read-file.js",
      "default": "./dist/src/local/read-file.js"
    },
    "./local/read-first-line": {
      "types": "./dist/src/local/read-first-line.d.ts",
      "import": "./dist/src/local/read-first-line.js",
      "default": "./dist/src/local/read-first-line.js"
    },
    "./local/write": {
      "types": "./dist/src/local/write.d.ts",
      "import": "./dist/src/local/write.js",
      "default": "./dist/src/local/write.js"
    },
    "./s3": {
      "types": "./dist/src/s3.d.ts",
      "import": "./dist/src/s3.js",
      "default": "./dist/src/s3.js"
    },
    "./storage": {
      "types": "./dist/src/storage/index.d.ts",
      "import": "./dist/src/storage/index.js",
      "default": "./dist/src/storage/index.js"
    },
    "./storage/index": {
      "types": "./dist/src/storage/index.d.ts",
      "import": "./dist/src/storage/index.js",
      "default": "./dist/src/storage/index.js"
    },
    "./storage/local-adapter": {
      "types": "./dist/src/storage/local-adapter.d.ts",
      "import": "./dist/src/storage/local-adapter.js",
      "default": "./dist/src/storage/local-adapter.js"
    },
    "./storage/r2": {
      "types": "./dist/src/storage/r2.d.ts",
      "import": "./dist/src/storage/r2.js",
      "default": "./dist/src/storage/r2.js"
    },
    "./storage/s3-adapter": {
      "types": "./dist/src/storage/s3-adapter.d.ts",
      "import": "./dist/src/storage/s3-adapter.js",
      "default": "./dist/src/storage/s3-adapter.js"
    },
    "./storage/types": {
      "types": "./dist/src/storage/types.d.ts",
      "import": "./dist/src/storage/types.js",
      "default": "./dist/src/storage/types.js"
    },
    "./files": {
      "types": "./dist/src/files/index.d.ts",
      "import": "./dist/src/files/index.js",
      "default": "./dist/src/files/index.js"
    },
    "./orpc": {
      "types": "./dist/src/orpc.d.ts",
      "import": "./dist/src/orpc.js",
      "default": "./dist/src/orpc.js"
    },
    "./pg": {
      "types": "./dist/src/pg/index.d.ts",
      "import": "./dist/src/pg/index.js",
      "default": "./dist/src/pg/index.js"
    },
    "./sqlite": {
      "types": "./dist/src/sqlite/index.d.ts",
      "import": "./dist/src/sqlite/index.js",
      "default": "./dist/src/sqlite/index.js"
    },
    "./testing": {
      "types": "./dist/src/testing.d.ts",
      "import": "./dist/src/testing.js",
      "default": "./dist/src/testing.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "bench": "arki-bench",
    "build": "tsc -p tsconfig.build.json",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc -p tsconfig.build.json --watch",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:pg": "vitest run --config vitest.pg.config.ts",
    "test:runtimes": "tsc -p tsconfig.runtimes.json && arki-runtimes",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "test:docs": "arki-doc-examples"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@arki/contracts": "workspace:*",
    "@arki/env": "workspace:*",
    "@arki/failure": "workspace:*",
    "@arki/log": "workspace:*",
    "@arki/schema": "workspace:*",
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@flystorage/aws-s3": "catalog:",
    "@flystorage/file-storage": "catalog:",
    "@flystorage/local-fs": "catalog:",
    "@opentelemetry/api": "catalog:opentelemetry",
    "@t3-oss/env-core": "catalog:env",
    "del": "catalog:",
    "glob": "catalog:",
    "iconv-lite": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@arki/bench": "workspace:*",
    "@arki/db": "workspace:*",
    "@arki/eslint-config": "workspace:*",
    "@arki/library-tooling": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/schedule": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "@electric-sql/pglite": "catalog:",
    "@libsql/client": "^0.18.0",
    "@opentelemetry/sdk-trace-base": "catalog:opentelemetry",
    "@orpc/contract": "catalog:backend",
    "@orpc/server": "catalog:backend",
    "@testcontainers/postgresql": "catalog:testing",
    "@types/pg": "catalog:drizzle",
    "drizzle-kit": "catalog:drizzle",
    "drizzle-orm": "catalog:drizzle",
    "pg": "catalog:drizzle"
  },
  "peerDependencies": {
    "@arki/db": "workspace:*",
    "@orpc/contract": "catalog:backend",
    "@orpc/server": "catalog:backend",
    "drizzle-orm": "catalog:drizzle"
  },
  "peerDependenciesMeta": {
    "@arki/db": {
      "optional": true
    },
    "@orpc/contract": {
      "optional": true
    },
    "@orpc/server": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    }
  },
  "files": [
    "dist/src/**",
    "!dist/src/**/*.test.*",
    "!dist/src/**/__tests__/**",
    "src/**",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/__tests__/**",
    "README.md",
    "docs/**",
    "llms.txt",
    "LICENSE",
    "CHANGELOG.md",
    "package.json"
  ]
}
