    "./files": {
      "types": "./dist/src/files/index.d.ts",
      "import": "./src/files/index.ts",
      "node": "./src/files/index.ts"
    },
    "./orpc": {
      "types": "./dist/src/orpc.d.ts",
      "import": "./src/orpc.ts",
      "node": "./src/orpc.ts"
    },
    "./pg": {
      "types": "./dist/src/pg/index.d.ts",
      "import": "./src/pg/index.ts",
      "node": "./src/pg/index.ts"
    },
    "./testing": {
      "types": "./dist/src/testing.d.ts",
      "import": "./src/testing.ts",
      "node": "./src/testing.ts"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "env": [
        "src/env.ts"
      ],
      "files": [
        "src/files/index.ts"
      ],
      "local/delete": [
        "src/local/delete.ts"
      ],
      "local/dir": [
        "src/local/dir.ts"
      ],
      "local/glob": [
        "src/local/glob.ts"
      ],
      "local/read-file": [
        "src/local/read-file.ts"
      ],
      "local/read-first-line": [
        "src/local/read-first-line.ts"
      ],
      "local/write": [
        "src/local/write.ts"
      ],
      "orpc": [
        "src/orpc.ts"
      ],
      "pg": [
        "src/pg/index.ts"
      ],
      "s3": [
        "src/s3.ts"
      ],
      "storage": [
        "src/storage/index.ts"
      ],
      "storage/index": [
        "src/storage/index.ts"
      ],
      "storage/local-adapter": [
        "src/storage/local-adapter.ts"
      ],
      "storage/r2": [
        "src/storage/r2.ts"
      ],
      "storage/s3-adapter": [
        "src/storage/s3-adapter.ts"
      ],
      "storage/types": [
        "src/storage/types.ts"
      ],
      "testing": [
        "src/testing.ts"
      ]
    }
  },
  "scripts": {
    "bench": "arki-bench",
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:pg": "vitest run --config vitest.pg.config.ts",
    "test:runtimes": "tsc -p tsconfig.runtimes.json && arki-runtimes",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@arki/contracts": "workspace:*",
    "@arki/env": "workspace:*",
    "@arki/failure": "workspace:*",
    "@arki/log": "workspace:*",
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@flystorage/aws-s3": "catalog:",
    "@flystorage/file-storage": "catalog:",
    "@flystorage/local-fs": "catalog:",
    "@t3-oss/env-core": "catalog:env",
    "del": "catalog:",
    "glob": "catalog:",
    "iconv-lite": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@arki/bench": "workspace:*",
    "@arki/db": "workspace:*",
    "@arki/eslint-config": "workspace:*",
    "@arki/library-tooling": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/schedule": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "@electric-sql/pglite": "catalog:",
    "@orpc/contract": "catalog:backend",
    "@orpc/server": "catalog:backend",
    "@testcontainers/postgresql": "catalog:testing",
    "@types/pg": "catalog:drizzle",
    "drizzle-kit": "catalog:drizzle",
    "drizzle-orm": "catalog:drizzle",
    "pg": "catalog:drizzle"
  },
  "peerDependencies": {
    "@arki/db": "workspace:*",
    "@orpc/contract": "catalog:backend",
    "@orpc/server": "catalog:backend",
    "drizzle-orm": "catalog:drizzle"
  },
  "peerDependenciesMeta": {
    "@arki/db": {
      "optional": true
    },
    "@orpc/contract": {
      "optional": true
    },
    "@orpc/server": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    }
  }
}
