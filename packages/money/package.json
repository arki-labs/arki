{
  "name": "@arki/money",
  "version": "0.0.4",
  "private": false,
  "description": "Exact, fast money for every JavaScript runtime — amounts kept as whole units (plain numbers, bigint only when huge), a shipped ISO 4217 currency table, exact-or-throw rounding, fair allocation, and currencies checked by the type system.",
  "keywords": [
    "arki",
    "typescript",
    "money",
    "currency",
    "iso4217",
    "monetary",
    "decimal",
    "rounding",
    "allocate",
    "bigint",
    "finance",
    "price",
    "exchange",
    "stripe",
    "parse"
  ],
  "homepage": "https://arki.dev",
  "bugs": {
    "url": "https://github.com/arki-labs/arki/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arki-labs/arki.git",
    "directory": "packages/money"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./currency": {
      "types": "./dist/currency.d.ts",
      "import": "./dist/currency.js",
      "default": "./dist/currency.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js",
      "default": "./dist/errors.js"
    },
    "./exact": {
      "types": "./dist/exact.d.ts",
      "import": "./dist/exact.js",
      "default": "./dist/exact.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "import": "./dist/format.js",
      "default": "./dist/format.js"
    },
    "./parse": {
      "types": "./dist/parse.d.ts",
      "import": "./dist/parse.js",
      "default": "./dist/parse.js"
    },
    "./exchange": {
      "types": "./dist/exchange.d.ts",
      "import": "./dist/exchange.js",
      "default": "./dist/exchange.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "import": "./dist/provider.js",
      "default": "./dist/provider.js"
    },
    "./stripe": {
      "types": "./dist/stripe.d.ts",
      "import": "./dist/stripe.js",
      "default": "./dist/stripe.js"
    },
    "./rational": {
      "types": "./dist/rational.d.ts",
      "import": "./dist/rational.js",
      "default": "./dist/rational.js"
    },
    "./bag": {
      "types": "./dist/bag.d.ts",
      "import": "./dist/bag.js",
      "default": "./dist/bag.js"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "import": "./dist/zod.js",
      "default": "./dist/zod.js"
    },
    "./drizzle/pg": {
      "types": "./dist/drizzle/pg.d.ts",
      "import": "./dist/drizzle/pg.js",
      "default": "./dist/drizzle/pg.js"
    },
    "./drizzle/mysql": {
      "types": "./dist/drizzle/mysql.d.ts",
      "import": "./dist/drizzle/mysql.js",
      "default": "./dist/drizzle/mysql.js"
    },
    "./drizzle/sqlite": {
      "types": "./dist/drizzle/sqlite.d.ts",
      "import": "./dist/drizzle/sqlite.js",
      "default": "./dist/drizzle/sqlite.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**",
    "src/**",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/__tests__/**",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "bench": "bun run build && arki-bench",
    "build": "tsc -p tsconfig.build.json",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc -p tsconfig.build.json --watch",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "generate:iso4217": "node scripts/generate-iso4217.mjs",
    "lint": "eslint .",
    "size": "bun run build && bun scripts/size.mjs",
    "test": "vitest run",
    "test:runtimes": "arki-runtimes",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@arki/math": "workspace:*"
  },
  "devDependencies": {
    "@arki/bench": "workspace:*",
    "@arki/eslint-config": "workspace:*",
    "@arki/library-tooling": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "@electric-sql/pglite": "catalog:",
    "@libsql/client": "^0.18.0",
    "@types/node": "catalog:node",
    "big.js": "catalog:",
    "currency.js": "^2.0.4",
    "dinero.js": "1",
    "drizzle-orm": "catalog:drizzle",
    "mysql2": "^3.24.5",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "drizzle-orm": ">=1.0.0-rc.4 <2",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
