{
  "name": "@arki/chat-ui",
  "version": "0.2.0",
  "description": "Chat and agent UI for React: styled assistant-ui primitives, tool call cards, thinking blocks, approval cards and a renderer for @arki/ai runtime streams.",
  "keywords": [
    "arki",
    "react",
    "chat",
    "agent",
    "ai",
    "assistant-ui",
    "tailwind"
  ],
  "homepage": "https://arki.dev",
  "bugs": {
    "url": "https://github.com/arki-labs/arki/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arki-labs/arki.git",
    "directory": "packages/chat-ui"
  },
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "exports": {
    "./thread": {
      "types": "./dist/src/thread.d.ts",
      "import": "./dist/src/thread.js",
      "default": "./dist/src/thread.js"
    },
    "./agent-panel": {
      "types": "./dist/src/agent-panel.d.ts",
      "import": "./dist/src/agent-panel.js",
      "default": "./dist/src/agent-panel.js"
    },
    "./runtime-conversation": {
      "types": "./dist/src/runtime-conversation.d.ts",
      "import": "./dist/src/runtime-conversation.js",
      "default": "./dist/src/runtime-conversation.js"
    },
    "./message": {
      "types": "./dist/src/message.d.ts",
      "import": "./dist/src/message.js",
      "default": "./dist/src/message.js"
    },
    "./composer": {
      "types": "./dist/src/composer.d.ts",
      "import": "./dist/src/composer.js",
      "default": "./dist/src/composer.js"
    },
    "./action-bar": {
      "types": "./dist/src/action-bar.d.ts",
      "import": "./dist/src/action-bar.js",
      "default": "./dist/src/action-bar.js"
    },
    "./branch-picker": {
      "types": "./dist/src/branch-picker.d.ts",
      "import": "./dist/src/branch-picker.js",
      "default": "./dist/src/branch-picker.js"
    },
    "./tool-call": {
      "types": "./dist/src/tool-call.d.ts",
      "import": "./dist/src/tool-call.js",
      "default": "./dist/src/tool-call.js"
    },
    "./thinking-block": {
      "types": "./dist/src/thinking-block.d.ts",
      "import": "./dist/src/thinking-block.js",
      "default": "./dist/src/thinking-block.js"
    },
    "./approval-card": {
      "types": "./dist/src/approval-card.d.ts",
      "import": "./dist/src/approval-card.js",
      "default": "./dist/src/approval-card.js"
    },
    "./step-indicator": {
      "types": "./dist/src/step-indicator.d.ts",
      "import": "./dist/src/step-indicator.js",
      "default": "./dist/src/step-indicator.js"
    },
    "./agent-status": {
      "types": "./dist/src/agent-status.d.ts",
      "import": "./dist/src/agent-status.js",
      "default": "./dist/src/agent-status.js"
    },
    "./code-block": {
      "types": "./dist/src/code-block.d.ts",
      "import": "./dist/src/code-block.js",
      "default": "./dist/src/code-block.js"
    },
    "./markdown-message": {
      "types": "./dist/src/markdown-message.d.ts",
      "import": "./dist/src/markdown-message.js",
      "default": "./dist/src/markdown-message.js"
    },
    "./tool-registry": {
      "types": "./dist/src/tool-registry.d.ts",
      "import": "./dist/src/tool-registry.js",
      "default": "./dist/src/tool-registry.js"
    },
    "./types": {
      "types": "./dist/src/types.d.ts",
      "import": "./dist/src/types.js",
      "default": "./dist/src/types.js"
    },
    "./styles/chat.css": "./src/styles/chat.css",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "thread": [
        "src/thread.tsx"
      ],
      "agent-panel": [
        "src/agent-panel.tsx"
      ],
      "runtime-conversation": [
        "src/runtime-conversation.tsx"
      ],
      "message": [
        "src/message.tsx"
      ],
      "composer": [
        "src/composer.tsx"
      ],
      "action-bar": [
        "src/action-bar.tsx"
      ],
      "branch-picker": [
        "src/branch-picker.tsx"
      ],
      "tool-call": [
        "src/tool-call.tsx"
      ],
      "thinking-block": [
        "src/thinking-block.tsx"
      ],
      "approval-card": [
        "src/approval-card.tsx"
      ],
      "step-indicator": [
        "src/step-indicator.tsx"
      ],
      "agent-status": [
        "src/agent-status.tsx"
      ],
      "code-block": [
        "src/code-block.tsx"
      ],
      "markdown-message": [
        "src/markdown-message.tsx"
      ],
      "tool-registry": [
        "src/tool-registry.tsx"
      ],
      "types": [
        "src/types.ts"
      ]
    }
  },
  "files": [
    "src/**",
    "!src/**/*.test.*",
    "!src/**/*.test-d.ts",
    "dist/src/**",
    "!dist/src/**/*.test.*",
    "!dist/src/**/*.test-d.*",
    "docs/*.md",
    "docs/recipes/**",
    "llms.txt",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc -p tsconfig.build.json --watch",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "test": "vitest run",
    "test:docs": "arki-doc-examples",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@arki/ai": "workspace:*",
    "@arki/icons": "workspace:*",
    "@arki/ui": "workspace:*",
    "@assistant-ui/react": "catalog:",
    "@assistant-ui/react-ai-sdk": "catalog:",
    "class-variance-authority": "catalog:styling",
    "clsx": "catalog:styling",
    "tailwind-merge": "catalog:styling"
  },
  "devDependencies": {
    "@arki/eslint-config": "workspace:*",
    "@arki/failure": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "engines": {
    "node": ">=22.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "module:jsx": "src",
  "arki": {
    "bundlerOnly": [
      "./thread",
      "./agent-panel",
      "./runtime-conversation",
      "./message",
      "./composer",
      "./action-bar",
      "./branch-picker",
      "./tool-call",
      "./thinking-block",
      "./approval-card",
      "./step-indicator",
      "./agent-status",
      "./code-block",
      "./markdown-message",
      "./styles/chat.css"
    ]
  }
}
