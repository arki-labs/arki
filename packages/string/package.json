{
  "name": "@arki/string",
  "private": true,
  "type": "module",
  "exports": {
    "./count-characters": {
      "types": "./dist/src/count/countCharacters.d.ts",
      "import": "./src/count/countCharacters.ts",
      "node": "./src/count/countCharacters.ts"
    },
    "./base64": {
      "types": "./dist/src/base64.d.ts",
      "import": "./src/base64.ts",
      "node": "./src/base64.ts"
    },
    "./utils": {
      "types": "./dist/src/utils.d.ts",
      "import": "./src/utils.ts",
      "node": "./src/utils.ts"
    },
    "./builder": {
      "types": "./dist/src/builder.d.ts",
      "import": "./src/builder.ts",
      "node": "./src/builder.ts"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "*": [
        "src/*"
      ]
    }
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "build": "tsc"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@poppinss/utils": "catalog:",
    "voca": "catalog:"
  },
  "devDependencies": {
    "@arki/eslint-config": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "@types/voca": "catalog:types"
  },
  "sideEffects": false
}
