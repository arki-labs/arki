{
  "name": "@arki/string",
  "version": "0.2.0",
  "description": "String toolkit — grapheme-aware slicing and truncation, case conversion, whitespace and word helpers, literal search and editing, HTML/RegExp escaping, templating, strict universal base64, multi-script slugs, and an immutable fluent wrapper.",
  "keywords": [
    "arki",
    "typescript",
    "string",
    "unicode",
    "grapheme",
    "case",
    "camelcase",
    "truncate",
    "base64",
    "utf8",
    "escape",
    "fluent",
    "utilities",
    "slug",
    "slugify",
    "transliteration"
  ],
  "homepage": "https://arki.dev",
  "bugs": {
    "url": "https://github.com/arki-labs/arki/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arki-labs/arki.git",
    "directory": "packages/string"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./unicode": {
      "types": "./dist/unicode.d.ts",
      "import": "./dist/unicode.js",
      "default": "./dist/unicode.js"
    },
    "./case": {
      "types": "./dist/case.d.ts",
      "import": "./dist/case.js",
      "default": "./dist/case.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "import": "./dist/format.js",
      "default": "./dist/format.js"
    },
    "./segment": {
      "types": "./dist/segment.d.ts",
      "import": "./dist/segment.js",
      "default": "./dist/segment.js"
    },
    "./search": {
      "types": "./dist/search.d.ts",
      "import": "./dist/search.js",
      "default": "./dist/search.js"
    },
    "./edit": {
      "types": "./dist/edit.d.ts",
      "import": "./dist/edit.js",
      "default": "./dist/edit.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js",
      "default": "./dist/errors.js"
    },
    "./escape": {
      "types": "./dist/escape.d.ts",
      "import": "./dist/escape.js",
      "default": "./dist/escape.js"
    },
    "./interpolate": {
      "types": "./dist/interpolate.d.ts",
      "import": "./dist/interpolate.js",
      "default": "./dist/interpolate.js"
    },
    "./base64": {
      "types": "./dist/base64.d.ts",
      "import": "./dist/base64.js",
      "default": "./dist/base64.js"
    },
    "./slug": {
      "types": "./dist/slug.d.ts",
      "import": "./dist/slug.js",
      "default": "./dist/slug.js"
    },
    "./slug-cjk": {
      "types": "./dist/slug/rules-cjk.d.ts",
      "import": "./dist/slug/rules-cjk.js",
      "default": "./dist/slug/rules-cjk.js"
    },
    "./readability": {
      "types": "./dist/readability.d.ts",
      "import": "./dist/readability.js",
      "default": "./dist/readability.js"
    },
    "./keywords": {
      "types": "./dist/keywords.d.ts",
      "import": "./dist/keywords.js",
      "default": "./dist/keywords.js"
    },
    "./vocabulary": {
      "types": "./dist/vocabulary.d.ts",
      "import": "./dist/vocabulary.js",
      "default": "./dist/vocabulary.js"
    },
    "./metrics": {
      "types": "./dist/metrics.d.ts",
      "import": "./dist/metrics.js",
      "default": "./dist/metrics.js"
    },
    "./distance": {
      "types": "./dist/distance.d.ts",
      "import": "./dist/distance.js",
      "default": "./dist/distance.js"
    },
    "./hash": {
      "types": "./dist/hash.d.ts",
      "import": "./dist/hash.js",
      "default": "./dist/hash.js"
    },
    "./fluent": {
      "types": "./dist/fluent.d.ts",
      "import": "./dist/fluent.js",
      "default": "./dist/fluent.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**",
    "src/**",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/tests/**",
    "!src/**/test/**",
    "!src/**/__tests__/**",
    "README.md",
    "LICENSE",
    "llms.txt",
    "docs/**",
    "AGENTS.md",
    "package.json"
  ],
  "scripts": {
    "bench": "bun run build && arki-bench",
    "build": "tsc -p tsconfig.build.json",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc -p tsconfig.build.json --watch",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "test": "vitest run",
    "test:bun": "bun --bun vitest run",
    "test:docs": "arki-doc-examples",
    "test:runtimes": "arki-runtimes",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false && tsc -p examples/tsconfig.json"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@arki/failure": "workspace:*"
  },
  "devDependencies": {
    "@arki/bench": "workspace:*",
    "@arki/eslint-config": "workspace:*",
    "@arki/library-tooling": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "@types/node": "catalog:node",
    "change-case": "^5.4.4",
    "escape-html": "^1.0.3",
    "lodash-es": "^4.18.1",
    "slugify": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
