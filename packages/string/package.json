{
  "name": "@arki/string",
  "version": "0.1.0",
  "description": "String manipulation utilities — case conversion, base64 encoding, character counting, and template builders.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/arki-dev/arki.git",
    "directory": "packages/string"
  },
  "homepage": "https://arki.dev",
  "bugs": {
    "url": "https://github.com/arki-dev/arki/issues"
  },
  "keywords": [
    "arki",
    "typescript",
    "string",
    "base64",
    "case",
    "utilities"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./base64": {
      "types": "./dist/base64.d.ts",
      "import": "./dist/base64.js",
      "default": "./dist/base64.js"
    },
    "./count-characters": {
      "types": "./dist/count/countCharacters.d.ts",
      "import": "./dist/count/countCharacters.js",
      "default": "./dist/count/countCharacters.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js",
      "default": "./dist/utils.js"
    },
    "./builder": {
      "types": "./dist/builder.d.ts",
      "import": "./dist/builder.js",
      "default": "./dist/builder.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc -p tsconfig.build.json --watch",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@poppinss/utils": "catalog:",
    "voca": "catalog:"
  },
  "devDependencies": {
    "@arki/eslint-config": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "@types/node": "catalog:node",
    "@types/voca": "catalog:types"
  }
}
