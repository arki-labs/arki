{
  "name": "@arki/geo",
  "version": "0.1.3",
  "private": false,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./src/index.ts",
      "node": "./src/index.ts"
    },
    "./react": {
      "types": "./dist/src/client.d.ts",
      "import": "./src/client.ts",
      "browser": "./src/client.ts"
    },
    "./geocoding": {
      "types": "./dist/src/geocoding/index.d.ts",
      "import": "./src/geocoding/index.ts",
      "node": "./src/geocoding/index.ts"
    },
    "./react/google-maps": {
      "types": "./dist/src/maps/google/index.d.ts",
      "import": "./src/maps/google/index.ts",
      "node": "./src/maps/google/index.ts"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "*": [
        "src/*"
      ],
      "client": [
        "src/client.ts"
      ],
      "geocoding": [
        "src/geocoding/index.ts"
      ],
      "maps/google": [
        "src/maps/google/index.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc -p tsconfig.build.json",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@arki/contracts": "workspace:*",
    "@arki/env": "workspace:*",
    "@arki/failure": "workspace:*",
    "@arki/kv": "workspace:*",
    "@arki/log": "workspace:*",
    "@arki/schema": "workspace:*",
    "@t3-oss/env-core": "catalog:env",
    "node-fetch": "^2.7.0",
    "node-geocoder": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@arki/eslint-config": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/testing": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "@testing-library/react": "catalog:testing",
    "@types/google.maps": "catalog:types",
    "@types/node": "catalog:node",
    "@types/node-fetch": "^2.6.0",
    "@types/node-geocoder": "catalog:types",
    "@types/react": "catalog:react",
    "@vis.gl/react-google-maps": "catalog:",
    "jsdom": "catalog:text-processing",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@vis.gl/react-google-maps": "catalog:",
    "leaflet": "catalog:",
    "mapbox-gl": "catalog:",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "react-leaflet": "catalog:",
    "react-map-gl": "catalog:"
  },
  "peerDependenciesMeta": {
    "@vis.gl/react-google-maps": {
      "optional": true
    },
    "leaflet": {
      "optional": true
    },
    "mapbox-gl": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-leaflet": {
      "optional": true
    },
    "react-map-gl": {
      "optional": true
    }
  },
  "types": "./dist/src/index.d.ts",
  "sideEffects": false
}
