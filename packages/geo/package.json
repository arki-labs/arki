{
  "name": "@arki/geo",
  "version": "0.2.0",
  "description": "Geospatial toolkit for ARKI: coordinates and distance maths, cached geocoding with typed failures, and React map components.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/arki-labs/arki.git",
    "directory": "packages/geo"
  },
  "homepage": "https://arki.dev",
  "bugs": {
    "url": "https://github.com/arki-labs/arki/issues"
  },
  "keywords": [
    "arki",
    "typescript",
    "geo",
    "geocoding",
    "maps",
    "coordinates",
    "distance"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./geocoding": {
      "types": "./dist/geocoding/index.d.ts",
      "import": "./dist/geocoding/index.js",
      "default": "./dist/geocoding/index.js"
    },
    "./react/google-maps": {
      "types": "./dist/maps/google/index.d.ts",
      "import": "./dist/maps/google/index.js",
      "default": "./dist/maps/google/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc -p tsconfig.build.json --watch",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "test:docs": "arki-doc-examples"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@arki/contracts": "workspace:*",
    "@arki/env": "workspace:*",
    "@arki/failure": "workspace:*",
    "@arki/kv": "workspace:*",
    "@arki/log": "workspace:*",
    "@arki/schema": "workspace:*",
    "@t3-oss/env-core": "catalog:env",
    "node-fetch": "^2.7.0",
    "node-geocoder": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@arki/eslint-config": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/testing": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "@testing-library/react": "catalog:testing",
    "@types/google.maps": "catalog:types",
    "@types/node": "catalog:node",
    "@types/node-fetch": "^2.6.0",
    "@types/node-geocoder": "catalog:types",
    "@types/react": "catalog:react",
    "@vis.gl/react-google-maps": "catalog:",
    "jsdom": "catalog:text-processing",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@vis.gl/react-google-maps": "catalog:",
    "leaflet": "catalog:",
    "mapbox-gl": "catalog:",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "react-leaflet": "catalog:",
    "react-map-gl": "catalog:"
  },
  "peerDependenciesMeta": {
    "@vis.gl/react-google-maps": {
      "optional": true
    },
    "leaflet": {
      "optional": true
    },
    "mapbox-gl": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-leaflet": {
      "optional": true
    },
    "react-map-gl": {
      "optional": true
    }
  },
  "files": [
    "dist/**",
    "!dist/**/*.test.*",
    "!dist/**/__tests__/**",
    "src/**",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/__tests__/**",
    "README.md",
    "docs/**",
    "llms.txt",
    "LICENSE",
    "CHANGELOG.md",
    "package.json"
  ]
}
