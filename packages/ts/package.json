{
  "name": "@arki/ts",
  "version": "0.1.0",
  "description": "TypeScript utility types — Prettify, DeepPartial, SnakeToCamel, RecordToPath, and other type helpers.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/arki-labs/arki.git",
    "directory": "packages/ts"
  },
  "homepage": "https://arki.dev",
  "bugs": {
    "url": "https://github.com/arki-labs/arki/issues"
  },
  "keywords": [
    "arki",
    "typescript",
    "types",
    "type-utilities",
    "prettify",
    "deep-partial"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./prettify": {
      "types": "./dist/prettify.d.ts",
      "import": "./dist/prettify.js",
      "default": "./dist/prettify.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js",
      "default": "./dist/utils.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**",
    "src/**",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/tests/**",
    "!src/**/test/**",
    "!src/**/__tests__/**",
    "README.md",
    "LICENSE",
    "llms.txt",
    "docs/**",
    "AGENTS.md",
    "package.json"
  ],
  "scripts": {
    "bench": "bun run build && arki-bench",
    "build": "tsc -p tsconfig.build.json",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc -p tsconfig.build.json --watch",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "test:runtimes": "arki-runtimes",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:docs": "arki-doc-examples"
  },
  "prettier": "@arki/prettier-config",
  "devDependencies": {
    "@arki/bench": "workspace:*",
    "@arki/eslint-config": "workspace:*",
    "@arki/library-tooling": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "@types/node": "catalog:node",
    "ts-essentials": "^10.2.1",
    "type-fest": "^5.10.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
