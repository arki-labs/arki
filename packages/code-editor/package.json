{
  "name": "@arki/code-editor",
  "version": "0.1.2",
  "description": "A CodeMirror 6 React code editor with 13 ready-made light and dark themes and a theme picker.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/arki-labs/arki.git",
    "directory": "packages/code-editor"
  },
  "homepage": "https://arki.dev",
  "bugs": {
    "url": "https://github.com/arki-labs/arki/issues"
  },
  "keywords": [
    "arki",
    "typescript",
    "code-editor",
    "codemirror",
    "react",
    "editor",
    "themes"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    "./editor": {
      "types": "./dist/src/editor.d.ts",
      "import": "./dist/src/editor.js",
      "default": "./dist/src/editor.js"
    },
    "./themes": {
      "types": "./dist/src/themes.d.ts",
      "import": "./dist/src/themes.js",
      "default": "./dist/src/themes.js"
    },
    "./theme-picker": {
      "types": "./dist/src/theme-picker.d.ts",
      "import": "./dist/src/theme-picker.js",
      "default": "./dist/src/theme-picker.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src/**",
    "!dist/src/**/*.test.*",
    "!dist/src/**/*.test-d.*",
    "src/**",
    "!src/**/*.test.*",
    "!src/**/*.test-d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc -p tsconfig.build.json --watch",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "test:docs": "arki-doc-examples",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@arki/icons": "workspace:*",
    "@arki/ui": "workspace:*",
    "@codemirror/lang-css": "catalog:codemirror",
    "@codemirror/lang-html": "catalog:codemirror",
    "@codemirror/lang-javascript": "catalog:codemirror",
    "@codemirror/lang-json": "catalog:codemirror",
    "@codemirror/lang-markdown": "catalog:codemirror",
    "@codemirror/lang-python": "catalog:codemirror",
    "@codemirror/lang-sql": "catalog:codemirror",
    "@codemirror/lang-xml": "catalog:codemirror",
    "@codemirror/lang-yaml": "catalog:codemirror",
    "@codemirror/state": "catalog:codemirror",
    "@codemirror/view": "catalog:codemirror",
    "@uiw/codemirror-theme-atomone": "^4.25.12",
    "@uiw/codemirror-theme-dracula": "^4.25.12",
    "@uiw/codemirror-theme-eclipse": "^4.25.12",
    "@uiw/codemirror-theme-github": "^4.25.12",
    "@uiw/codemirror-theme-gruvbox-dark": "^4.25.12",
    "@uiw/codemirror-theme-monokai": "^4.25.12",
    "@uiw/codemirror-theme-nord": "^4.25.12",
    "@uiw/codemirror-theme-quietlight": "^4.25.12",
    "@uiw/codemirror-theme-tokyo-night": "^4.25.12",
    "@uiw/codemirror-theme-vscode": "^4.25.12",
    "@uiw/codemirror-theme-xcode": "^4.25.12",
    "@uiw/codemirror-themes-all": "catalog:",
    "@uiw/react-codemirror": "catalog:"
  },
  "devDependencies": {
    "@arki/eslint-config": "workspace:*",
    "@arki/failure": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "react": "catalog:react",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "arki": {
    "bundlerOnly": [
      "./theme-picker"
    ]
  }
}
