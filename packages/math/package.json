{
  "name": "@arki/math",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    "./number": "./src/number.ts",
    "./fractions": "./src/fractions.ts",
    "./react-integration": "./src/integrations/react/index.tsx",
    "./stat": "./src/stat.ts"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./src/*"
      ]
    }
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "big.js": "catalog:",
    "bignumber.js": "catalog:",
    "decimal.js": "catalog:",
    "jstat": "catalog:",
    "katex": "catalog:",
    "mathjs": "catalog:",
    "react-katex": "catalog:",
    "recharts": "catalog:",
    "simple-statistics": "catalog:"
  },
  "devDependencies": {
    "@arki/eslint-config": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "@types/big.js": "catalog:types",
    "@types/katex": "catalog:types"
  }
}
