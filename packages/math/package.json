{
  "name": "@arki/math",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    "./number": {
      "types": "./dist/src/number.d.ts",
      "import": "./src/number.ts",
      "node": "./src/number.ts"
    },
    "./fractions": {
      "types": "./dist/src/fractions.d.ts",
      "import": "./src/fractions.ts",
      "node": "./src/fractions.ts"
    },
    "./react-integration": {
      "types": "./dist/src/integrations/react/index.d.ts",
      "import": "./src/integrations/react/index.tsx",
      "browser": "./src/integrations/react/index.tsx"
    },
    "./stat": {
      "types": "./dist/src/stat.d.ts",
      "import": "./src/stat.ts",
      "node": "./src/stat.ts"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./src/*"
      ]
    }
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "build": "tsc"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "big.js": "catalog:",
    "bignumber.js": "catalog:",
    "decimal.js": "catalog:",
    "jstat": "catalog:",
    "katex": "catalog:",
    "mathjs": "catalog:",
    "react-katex": "catalog:",
    "recharts": "catalog:",
    "simple-statistics": "catalog:"
  },
  "devDependencies": {
    "@arki/eslint-config": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "@types/big.js": "catalog:types",
    "@types/katex": "catalog:types"
  },
  "sideEffects": false
}
