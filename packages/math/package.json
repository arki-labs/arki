{
  "name": "@arki/math",
  "version": "0.0.9",
  "private": false,
  "description": "Zero-dependency math toolkit — exact Decimal and Rational arithmetic on bigint, explicit rounding modes, float helpers that round what you typed, descriptive statistics, Intl-backed locale formatting and parsing, seeded random, and a fluent number wrapper.",
  "keywords": [
    "arki",
    "typescript",
    "math",
    "decimal",
    "bigdecimal",
    "rational",
    "fraction",
    "bigint",
    "rounding",
    "statistics",
    "format",
    "intl",
    "locale",
    "parse",
    "random",
    "fluent"
  ],
  "homepage": "https://arki.dev",
  "bugs": {
    "url": "https://github.com/arki-labs/arki/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arki-labs/arki.git",
    "directory": "packages/math"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js",
      "default": "./dist/errors.js"
    },
    "./rounding": {
      "types": "./dist/rounding.d.ts",
      "import": "./dist/rounding.js",
      "default": "./dist/rounding.js"
    },
    "./number": {
      "types": "./dist/number.d.ts",
      "import": "./dist/number.js",
      "default": "./dist/number.js"
    },
    "./integer": {
      "types": "./dist/integer.d.ts",
      "import": "./dist/integer.js",
      "default": "./dist/integer.js"
    },
    "./decimal": {
      "types": "./dist/decimal.d.ts",
      "import": "./dist/decimal.js",
      "default": "./dist/decimal.js"
    },
    "./decimal-math": {
      "types": "./dist/decimal-math.d.ts",
      "import": "./dist/decimal-math.js",
      "default": "./dist/decimal-math.js"
    },
    "./rational": {
      "types": "./dist/rational.d.ts",
      "import": "./dist/rational.js",
      "default": "./dist/rational.js"
    },
    "./stats": {
      "types": "./dist/stats.d.ts",
      "import": "./dist/stats.js",
      "default": "./dist/stats.js"
    },
    "./distributions": {
      "types": "./dist/distributions.d.ts",
      "import": "./dist/distributions.js",
      "default": "./dist/distributions.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "import": "./dist/format.js",
      "default": "./dist/format.js"
    },
    "./parse": {
      "types": "./dist/parse.d.ts",
      "import": "./dist/parse.js",
      "default": "./dist/parse.js"
    },
    "./random": {
      "types": "./dist/random.d.ts",
      "import": "./dist/random.js",
      "default": "./dist/random.js"
    },
    "./fluent": {
      "types": "./dist/fluent.d.ts",
      "import": "./dist/fluent.js",
      "default": "./dist/fluent.js"
    },
    "./words": {
      "types": "./dist/words.d.ts",
      "import": "./dist/words.js",
      "default": "./dist/words.js"
    },
    "./words/*": {
      "types": "./dist/words/*.d.ts",
      "import": "./dist/words/*.js",
      "default": "./dist/words/*.js"
    },
    "./units": {
      "types": "./dist/units.d.ts",
      "default": "./dist/units.js"
    },
    "./finance": {
      "types": "./dist/finance.d.ts",
      "default": "./dist/finance.js"
    },
    "./finance/float": {
      "types": "./dist/finance-float.d.ts",
      "default": "./dist/finance-float.js"
    },
    "./roots": {
      "types": "./dist/roots.d.ts",
      "default": "./dist/roots.js"
    },
    "./integrate": {
      "types": "./dist/integrate.d.ts",
      "default": "./dist/integrate.js"
    },
    "./differentiate": {
      "types": "./dist/differentiate.d.ts",
      "default": "./dist/differentiate.js"
    },
    "./geometry": {
      "types": "./dist/geometry.d.ts",
      "default": "./dist/geometry.js"
    },
    "./linear-algebra": {
      "types": "./dist/linear-algebra.d.ts",
      "default": "./dist/linear-algebra.js"
    },
    "./complex": {
      "types": "./dist/complex.d.ts",
      "default": "./dist/complex.js"
    },
    "./polynomial": {
      "types": "./dist/polynomial.d.ts",
      "default": "./dist/polynomial.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**",
    "src/**",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/__tests__/**",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "bench": "bun run build && arki-bench",
    "build": "tsc -p tsconfig.build.json",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc -p tsconfig.build.json --watch",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "test": "vitest run",
    "test:runtimes": "arki-runtimes",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "prettier": "@arki/prettier-config",
  "devDependencies": {
    "@arki/bench": "workspace:*",
    "@arki/eslint-config": "workspace:*",
    "@arki/library-tooling": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "@types/node": "catalog:node",
    "big.js": "catalog:",
    "bignumber.js": "catalog:",
    "complex.js": "^2.4.3",
    "decimal.js": "catalog:",
    "fast-check": "^4.10.2",
    "fraction.js": "^5.3.4",
    "jstat": "catalog:",
    "mathjs": "catalog:",
    "ml-matrix": "^6.15.0",
    "regression": "^2.0.1",
    "simple-statistics": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
