{
  "name": "@arki/offline",
  "version": "0.1.0",
  "description": "Offline-first building blocks for TanStack apps: a persisted query cache, a replayable mutation queue with dead letters, local collections, PWA caching, and an oRPC idempotency guard.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/arki-labs/arki.git",
    "directory": "packages/offline"
  },
  "homepage": "https://arki.dev",
  "bugs": {
    "url": "https://github.com/arki-labs/arki/issues"
  },
  "keywords": [
    "arki",
    "typescript",
    "offline",
    "offline-first",
    "pwa",
    "tanstack-query",
    "tanstack-db",
    "mutation-queue"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    "./query": {
      "types": "./dist/src/query/index.d.ts",
      "import": "./dist/src/query/index.js",
      "default": "./dist/src/query/index.js"
    },
    "./mutations": {
      "types": "./dist/src/mutations/index.d.ts",
      "import": "./dist/src/mutations/index.js",
      "default": "./dist/src/mutations/index.js"
    },
    "./collections": {
      "types": "./dist/src/collections/index.d.ts",
      "import": "./dist/src/collections/index.js",
      "default": "./dist/src/collections/index.js"
    },
    "./pwa": {
      "types": "./dist/src/pwa/index.d.ts",
      "import": "./dist/src/pwa/index.js",
      "default": "./dist/src/pwa/index.js"
    },
    "./status": {
      "types": "./dist/src/status/index.d.ts",
      "import": "./dist/src/status/index.js",
      "default": "./dist/src/status/index.js"
    },
    "./orpc": {
      "types": "./dist/src/orpc/index.d.ts",
      "node": "./dist/src/orpc/index.js",
      "browser": "./dist/src/orpc/index.browser.js",
      "default": "./dist/src/orpc/index.browser.js"
    },
    "./devtools": {
      "types": "./dist/src/devtools/index.d.ts",
      "import": "./dist/src/devtools/index.js",
      "default": "./dist/src/devtools/index.js"
    },
    "./preset": {
      "types": "./dist/src/preset/index.d.ts",
      "import": "./dist/src/preset/index.js",
      "default": "./dist/src/preset/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "tsc -p tsconfig.build.json",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:docs": "arki-doc-examples",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@arki/async": "workspace:*",
    "@arki/contracts": "workspace:*",
    "@arki/date": "workspace:*",
    "@arki/failure": "workspace:*",
    "@arki/log": "workspace:*",
    "@arki/resilience": "workspace:*",
    "@arki/schema": "workspace:*",
    "@opentelemetry/api": "catalog:opentelemetry",
    "@tanstack/db": "catalog:",
    "@tanstack/query-async-storage-persister": "catalog:tanstack/react-query",
    "@tanstack/query-persist-client-core": "^5.104.1",
    "@tanstack/react-db": "catalog:",
    "@tanstack/react-query-persist-client": "catalog:tanstack/react-query",
    "idb-keyval": "catalog:",
    "superjson": "catalog:utilities",
    "workbox-expiration": "catalog:tanstack/start",
    "workbox-routing": "catalog:tanstack/start",
    "workbox-strategies": "catalog:tanstack/start"
  },
  "peerDependencies": {
    "@arki/db": "workspace:*",
    "@orpc/contract": "catalog:backend",
    "@orpc/server": "catalog:backend",
    "@tanstack/react-query": "catalog:tanstack/react-query",
    "drizzle-orm": "catalog:drizzle",
    "react": "catalog:react"
  },
  "peerDependenciesMeta": {
    "@arki/db": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arki/db": "workspace:*",
    "@arki/eslint-config": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/testing": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "@electric-sql/pglite": "catalog:",
    "@libsql/client": "^0.18.0",
    "@opentelemetry/sdk-trace-base": "catalog:opentelemetry",
    "@orpc/contract": "catalog:backend",
    "@orpc/server": "catalog:backend",
    "@tanstack/react-query": "catalog:tanstack/react-query",
    "@testing-library/react": "catalog:testing",
    "@types/node": "catalog:node",
    "@types/pg": "catalog:drizzle",
    "@types/react": "catalog:react",
    "@vitejs/plugin-react": "catalog:",
    "drizzle-kit": "catalog:drizzle",
    "drizzle-orm": "catalog:drizzle",
    "jsdom": "catalog:text-processing",
    "pg": "catalog:drizzle",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "files": [
    "dist/src/**",
    "!dist/src/**/*.test.*",
    "src/**",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "README.md",
    "docs/api.md",
    "docs/upgrades/**",
    "llms.txt",
    "LICENSE"
  ],
  "arki": {
    "bundlerOnly": [
      "./pwa"
    ]
  }
}
