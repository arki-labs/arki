{
  "name": "@arki/payments",
  "version": "0.3.0",
  "description": "Payments for ARKI apps — Stripe provider, plans, customers, subscriptions, payments, refunds, dunning and tax, as Drizzle table factories, repositories, services and @arki/journal commands.",
  "keywords": [
    "arki",
    "typescript",
    "payments",
    "stripe",
    "subscriptions",
    "billing",
    "refunds",
    "dunning",
    "drizzle"
  ],
  "homepage": "https://arki.dev",
  "bugs": {
    "url": "https://github.com/arki-labs/arki/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arki-labs/arki.git",
    "directory": "packages/payments"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./presets": {
      "types": "./dist/presets/index.d.ts",
      "import": "./dist/presets/index.js",
      "default": "./dist/presets/index.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "import": "./dist/env.js",
      "default": "./dist/env.js"
    },
    "./dunning": {
      "types": "./dist/dunning/index.d.ts",
      "import": "./dist/dunning/index.js",
      "default": "./dist/dunning/index.js"
    },
    "./tax": {
      "types": "./dist/tax/index.d.ts",
      "import": "./dist/tax/index.js",
      "default": "./dist/tax/index.js"
    },
    "./refunds": {
      "types": "./dist/refunds/index.d.ts",
      "import": "./dist/refunds/index.js",
      "default": "./dist/refunds/index.js"
    },
    "./repositories": {
      "types": "./dist/repositories.d.ts",
      "import": "./dist/repositories.js",
      "default": "./dist/repositories.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**",
    "src/**",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/__tests__/**",
    "!src/**/*test-support.ts",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc -p tsconfig.build.json --watch",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@arki/contracts": "workspace:*",
    "@arki/date": "workspace:*",
    "@arki/db": "workspace:*",
    "@arki/env": "workspace:*",
    "@arki/journal": "workspace:*",
    "@arki/kv": "workspace:*",
    "@arki/log": "workspace:*",
    "@arki/money": "workspace:*",
    "@t3-oss/env-core": "catalog:env",
    "drizzle-orm": "catalog:drizzle",
    "stripe": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@arki/eslint-config": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "@electric-sql/pglite": "catalog:",
    "@types/node": "catalog:node",
    "drizzle-kit": "catalog:drizzle",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
