{
  "name": "@arki/content",
  "version": "0.1.2",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./rss": {
      "types": "./dist/src/rss/index.d.ts",
      "import": "./src/rss/index.ts",
      "default": "./src/rss/index.ts"
    },
    "./rss/generate": {
      "types": "./dist/src/rss/generate.d.ts",
      "import": "./src/rss/generate.ts",
      "default": "./src/rss/generate.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "test": "vitest run",
    "test:runtimes": "bun build src/index.ts --target=node --outfile=.cache/runtimes-dist/index.js && arki-runtimes",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "fast-xml-parser": "catalog:",
    "minisearch": "catalog:"
  },
  "devDependencies": {
    "@arki/eslint-config": "workspace:*",
    "@arki/library-tooling": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "vitest": "catalog:"
  }
}
