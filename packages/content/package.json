{
  "name": "@arki/content",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./collections/*": {
      "default": "./src/collections/*.ts"
    },
    "./components/*": {
      "default": "./src/components/*.tsx"
    },
    "./next": {
      "default": "./src/next.ts"
    },
    "./mdx": {
      "default": "./src/mdx.ts"
    },
    "./core": {
      "default": "./src/core.ts"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "src/*"
      ]
    }
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@arki/base-ui": "workspace:*",
    "@arki/date": "workspace:*",
    "@arki/react-hooks": "workspace:*",
    "@arki/rss": "workspace:*",
    "@arki/ui": "workspace:*",
    "@code-hike/mdx": "0.9.0",
    "@content-collections/core": "0.8.0",
    "@content-collections/mdx": "0.2.0",
    "@content-collections/next": "0.2.4",
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^15.1.7",
    "mdx-bundler": "^10.1.0",
    "minisearch": "^7.1.1",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.0",
    "rehype-react": "^8.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "schema-dts": "^1.1.2",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@arki/eslint-config": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*"
  }
}
