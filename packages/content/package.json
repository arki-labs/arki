{
  "name": "@arki/content",
  "version": "0.2.0",
  "description": "Content helpers for blogs and docs: RSS and Atom feed parsing and generation, post search with MiniSearch, and typed queries over generated collections.",
  "keywords": [
    "arki",
    "content",
    "rss",
    "atom",
    "feed",
    "search",
    "blog"
  ],
  "homepage": "https://arki.dev",
  "bugs": {
    "url": "https://github.com/arki-labs/arki/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arki-labs/arki.git",
    "directory": "packages/content"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./rss": {
      "types": "./dist/src/rss/index.d.ts",
      "import": "./dist/src/rss/index.js",
      "default": "./dist/src/rss/index.js"
    },
    "./rss/generate": {
      "types": "./dist/src/rss/generate.d.ts",
      "import": "./dist/src/rss/generate.js",
      "default": "./dist/src/rss/generate.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**",
    "src/**",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/*.stories.*",
    "!src/**/tests/**",
    "!src/**/test/**",
    "!src/**/__tests__/**",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc -p tsconfig.build.json --watch",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "test": "vitest run",
    "test:runtimes": "bun build src/index.ts --target=node --outfile=.cache/runtimes-dist/index.js && arki-runtimes",
    "test:docs": "arki-doc-examples",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@arki/failure": "workspace:*",
    "fast-xml-parser": "catalog:",
    "minisearch": "catalog:"
  },
  "devDependencies": {
    "@arki/eslint-config": "workspace:*",
    "@arki/library-tooling": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
