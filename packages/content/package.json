{
  "name": "@arki/content",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./collections/*": {
      "types": "./dist/src/collections/*.d.ts",
      "import": "./src/collections/*.ts",
      "browser": "./src/collections/*.ts"
    },
    "./components/*": {
      "types": "./dist/src/components/*.d.ts",
      "import": "./src/components/*.tsx",
      "browser": "./src/components/*.tsx"
    },
    "./next": {
      "types": "./dist/src/next.d.ts",
      "import": "./src/next.ts",
      "node": "./src/next.ts"
    },
    "./mdx": {
      "types": "./dist/src/mdx.d.ts",
      "import": "./src/mdx.ts",
      "browser": "./src/mdx.ts"
    },
    "./core": {
      "types": "./dist/src/core.d.ts",
      "import": "./src/core.ts",
      "browser": "./src/core.ts"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "*": [
        "src/*"
      ]
    }
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "build": "tsc"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@arki/contracts": "workspace:*",
    "@arki/date": "workspace:*",
    "@arki/icons": "workspace:*",
    "@arki/intl": "workspace:*",
    "@arki/react-hooks": "workspace:*",
    "@arki/rss": "workspace:*",
    "@arki/ui": "workspace:*",
    "@code-hike/mdx": "catalog:",
    "@content-collections/core": "catalog:next",
    "@content-collections/mdx": "catalog:next",
    "@content-collections/next": "catalog:next",
    "@mdx-js/loader": "catalog:content",
    "@mdx-js/react": "catalog:content",
    "@next/mdx": "catalog:next",
    "mdx-bundler": "catalog:content",
    "minisearch": "catalog:",
    "reading-time": "catalog:content",
    "rehype-autolink-headings": "catalog:content",
    "rehype-pretty-code": "catalog:content",
    "rehype-react": "catalog:content",
    "rehype-slug": "catalog:content",
    "remark-gfm": "catalog:content",
    "schema-dts": "catalog:",
    "unified": "catalog:"
  },
  "devDependencies": {
    "@arki/eslint-config": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*"
  },
  "sideEffects": false
}
