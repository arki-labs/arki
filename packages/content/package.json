{
  "name": "@arki/content",
  "version": "0.1.2",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./node": {
      "types": "./dist/src/node.d.ts",
      "import": "./src/node.ts",
      "default": "./src/node.ts"
    },
    "./react": {
      "types": "./dist/src/react.d.ts",
      "import": "./src/react.ts",
      "default": "./src/react.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@arki/contracts": "workspace:*",
    "@arki/date": "workspace:*",
    "@arki/icons": "workspace:*",
    "@arki/intl": "workspace:*",
    "@arki/math": "workspace:*",
    "@arki/react-hooks": "workspace:*",
    "@arki/rss": "workspace:*",
    "@arki/ui": "workspace:*",
    "@code-hike/mdx": "catalog:",
    "@content-collections/core": "catalog:next",
    "@content-collections/mdx": "catalog:next",
    "@mdx-js/loader": "catalog:content",
    "@mdx-js/react": "catalog:content",
    "mdx-bundler": "catalog:content",
    "minisearch": "catalog:",
    "reading-time": "catalog:content",
    "rehype-autolink-headings": "catalog:content",
    "rehype-pretty-code": "catalog:content",
    "rehype-react": "catalog:content",
    "rehype-slug": "catalog:content",
    "remark-gfm": "catalog:content",
    "schema-dts": "catalog:",
    "sharp": "catalog:image-processing",
    "unified": "catalog:"
  },
  "devDependencies": {
    "@arki/eslint-config": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*"
  }
}
