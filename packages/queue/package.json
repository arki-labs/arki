{
  "name": "@arki/queue",
  "version": "0.1.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./src/index.ts",
      "node": "./src/index.ts"
    },
    "./types": {
      "types": "./dist/src/types/index.d.ts",
      "import": "./src/types/index.ts",
      "node": "./src/types/index.ts"
    },
    "./runtime-local": {
      "types": "./dist/src/runtime-local/index.d.ts",
      "import": "./src/runtime-local/index.ts",
      "node": "./src/runtime-local/index.ts"
    },
    "./dot": {
      "types": "./dist/src/dot.d.ts",
      "import": "./src/dot.ts",
      "node": "./src/dot.ts",
      "default": "./dist/src/dot.js"
    },
    "./projection": {
      "types": "./dist/src/projection.d.ts",
      "import": "./src/projection.ts",
      "node": "./src/projection.ts",
      "default": "./dist/src/projection.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "tsc -p tsconfig.build.json --watch",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@arki/contracts": "workspace:*",
    "@arki/log": "workspace:*",
    "@bull-board/api": "catalog:queue",
    "@bull-board/hono": "catalog:queue",
    "@electric-sql/pglite": "catalog:",
    "bullmq": "catalog:queue",
    "hono": "catalog:backend",
    "ioredis": "catalog:queue",
    "pg-boss": "catalog:queue",
    "superjson": "catalog:utilities",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@arki/dot": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@arki/dot": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arki/dot": "workspace:*",
    "@arki/eslint-config": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/testing": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "@types/node": "catalog:node",
    "testcontainers": "catalog:testing",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
