{
  "name": "@arki/queue",
  "version": "0.2.0",
  "description": "Typed background jobs for TypeScript: BullMQ on Redis, pg-boss on PGlite, or a database row that commits with your transaction.",
  "repository": {
    "type": "git",
    "url": "https://github.com/arki-labs/arki.git",
    "directory": "packages/queue"
  },
  "license": "MIT",
  "homepage": "https://arki.dev",
  "bugs": {
    "url": "https://github.com/arki-labs/arki/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "default": "./dist/types/index.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js",
      "default": "./dist/errors.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "import": "./dist/contract.js",
      "default": "./dist/contract.js"
    },
    "./runtime-local": {
      "types": "./dist/runtime-local/index.d.ts",
      "import": "./dist/runtime-local/index.js",
      "default": "./dist/runtime-local/index.js"
    },
    "./dot": {
      "types": "./dist/dot.d.ts",
      "import": "./dist/dot.js",
      "default": "./dist/dot.js"
    },
    "./outbox": {
      "types": "./dist/outbox/index.d.ts",
      "import": "./dist/outbox/index.js",
      "default": "./dist/outbox/index.js"
    },
    "./projection": {
      "types": "./dist/projection.d.ts",
      "import": "./dist/projection.js",
      "default": "./dist/projection.js"
    },
    "./foreman": {
      "types": "./dist/foreman/index.d.ts",
      "import": "./dist/foreman/index.js",
      "default": "./dist/foreman/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**",
    "src/**",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/*.fixture.*",
    "CHANGELOG.md",
    "README.md",
    "llms.txt",
    "docs/agent-guide.md",
    "docs/recipes/**",
    "docs/reference/**",
    "docs/upgrades/**",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "tsc -p tsconfig.build.json --watch",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:docs": "arki-doc-examples",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@arki/async": "workspace:*",
    "@arki/contracts": "workspace:*",
    "@arki/failure": "workspace:*",
    "@arki/journal": "workspace:*",
    "@arki/log": "workspace:*",
    "@arki/resilience": "workspace:*",
    "@arki/schedule": "workspace:*",
    "@arki/schema": "workspace:*",
    "@bull-board/api": "catalog:queue",
    "@bull-board/hono": "catalog:queue",
    "@electric-sql/pglite": "catalog:",
    "@opentelemetry/api": "catalog:opentelemetry",
    "bullmq": "catalog:queue",
    "drizzle-orm": "catalog:drizzle",
    "hono": "catalog:backend",
    "ioredis": "catalog:queue",
    "pg-boss": "catalog:queue",
    "superjson": "catalog:utilities",
    "uuid": "catalog:utilities",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@arki/admin": "workspace:*",
    "@arki/dot": "workspace:*",
    "@arki/eslint-config": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/testing": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "@opentelemetry/sdk-trace-base": "catalog:opentelemetry",
    "@types/node": "catalog:node",
    "drizzle-kit": "catalog:drizzle",
    "testcontainers": "catalog:testing",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@arki/admin": "workspace:*",
    "@arki/dot": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@arki/admin": {
      "optional": true
    },
    "@arki/dot": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "arki",
    "typescript",
    "queue",
    "jobs",
    "background-jobs",
    "bullmq",
    "pg-boss",
    "outbox"
  ]
}
