{
  "name": "@arki/queue",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./src/index.ts",
      "node": "./src/index.ts"
    },
    "./types": {
      "types": "./dist/src/types/index.d.ts",
      "import": "./src/types/index.ts",
      "node": "./src/types/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "dev": "tsc",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@arki/contracts": "workspace:*",
    "@bull-board/api": "catalog:queue",
    "@bull-board/hono": "catalog:queue",
    "bullmq": "catalog:queue",
    "ioredis": "catalog:queue",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@arki/eslint-config": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "@types/node": "catalog:node",
    "testcontainers": "^10.14.0",
    "typescript": "catalog:"
  },
  "types": "./dist/index.d.ts",
  "sideEffects": false
}
