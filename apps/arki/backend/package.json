{
  "name": "@arki/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./features/*": "./src/features/*/types.ts",
    "./types": "./src/features/types.ts",
    "./auth": "./src/core/auth/index.ts",
    "./db": "./src/db.ts",
    "./env": "./src/env.ts",
    "./api": "./src/api.ts",
    "./fleet": "./src/features/fleet/handler.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo node_modules",
    "db:migrations:generate": "bun run with-env drizzle-kit generate",
    "db:schema:push": "bun run with-env drizzle-kit push",
    "db:studio": "bun run with-env drizzle-kit studio",
    "format": "prettier --check . --ignore-path ../../../.gitignore",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "up": "bun run with-env drizzle-kit up",
    "with-env": "dotenv -e ../../../.env -e ../.env --"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@arki/admin": "workspace:*",
    "@arki/assert": "workspace:*",
    "@arki/auth": "workspace:*",
    "@arki/contracts": "workspace:*",
    "@arki/db": "workspace:*",
    "@arki/dot": "workspace:*",
    "@arki/emails": "workspace:*",
    "@arki/env": "workspace:*",
    "@arki/event-sourcing": "workspace:*",
    "@arki/fs": "workspace:*",
    "@arki/kv": "workspace:*",
    "@arki/log": "workspace:*",
    "@arki/meter": "workspace:*",
    "@better-auth/expo": "catalog:better-auth",
    "@orpc/server": "catalog:backend",
    "@trigger.dev/sdk": "catalog:trigger",
    "better-auth": "catalog:better-auth"
  },
  "devDependencies": {
    "@arki/eslint-config": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "@better-auth/cli": "catalog:better-auth",
    "@t3-oss/env-core": "catalog:env",
    "@trigger.dev/build": "catalog:trigger",
    "dotenv-cli": "catalog:env",
    "drizzle-kit": "catalog:drizzle",
    "tsx": "catalog:"
  }
}
