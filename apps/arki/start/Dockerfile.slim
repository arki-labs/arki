# syntax=docker/dockerfile:1-labs
#
# Slim Dockerfile — runs Nitro's self-contained `.output/` bundle under Bun.
# Drops ~5 GB of root node_modules + 3 GB of packages/ that older versions
# copied into the runtime image, even though the Nitro bundle has already
# inlined every vendor dep it needs into `_libs/`.
#
# Build-time env injection:
#   - Coolify automatically appends `--mount=type=secret,id=X,env=X` to every
#     RUN command for each configured app secret (DB_URL, AUTH_SECRET,
#     VITE_*, SENTRY_*, etc.), so those vars are available to `turbo build`
#     and `bun install` without ARG/ENV declarations here. This Dockerfile
#     therefore declares NO secret ARGs (avoids `SecretsUsedInArgOrEnv`
#     BuildKit warnings and prevents secrets being baked into image layers).
#
# Runtime env injection:
#   - Coolify starts the container via `docker compose up`, which provides
#     runtime env vars from the Coolify app config. The runner stage therefore
#     does not declare ARG/ENV for any secret — the live container inherits
#     them from compose, not from the image.
#
ARG application_name=arki

# ============================================================================
# Stage: bun-base — donates the Bun binary into the build stages.
# ============================================================================
FROM oven/bun:1-alpine AS bun-base

# ============================================================================
# Stage: base — Node + Turbo + Bun, shared by pruner / deps / builder.
# Heavy build deps live here; runner does NOT inherit from this.
# ============================================================================
FROM node:26.11.1-alpine AS base
ARG SYSTEM_PACKAGES="libc6-compat python3 make g++ bash postgresql-dev git"
RUN apk update && \
  apk add --no-cache ${SYSTEM_PACKAGES} && \
  npm install -g turbo
COPY --from=bun-base /usr/local/bin/bun /usr/local/bin/bun
RUN ln -s /usr/local/bin/bun /usr/local/bin/bunx

# ============================================================================
# Stage: pruner — emits the minimal monorepo SOURCE subset to build the app.
# Used only by `builder` below. The deps stage gets workspace METADATA from
# a separate path that preserves the full workspace shape (see below).
# ============================================================================
FROM base AS pruner
ARG application_name
WORKDIR /app
COPY . .
RUN turbo prune --scope=@${application_name}/start --docker

# ============================================================================
# Stage: deps — install the full workspace dep graph against the FULL lockfile
# with --frozen-lockfile for reproducibility.
#
# Why not `--filter "@app/start..."` to scope the install? Bun's filter
# installs prod+dev deps for the filter target but only PROD deps for
# transitive workspaces. Many @arki/* packages need their own devDeps
# (typescript → tsc) to build during `turbo build` — with --filter, those
# binaries are absent and workspace-package builds fail (exit 127).
#
# Why a metadata-only copy (full workspace shape, no source)? So this layer's
# cache key is "package.json + lockfile state", invariant to source changes —
# rebuilds that don't touch the dep graph reuse the cached install.
# `COPY --parents` requires the `dockerfile:1-labs` frontend (top of file).
# `--exclude=**/dist` etc. skips build-artifact package.jsons (e.g. dual-format
# ESM/CJS hint files) that are NOT workspace members.
# ============================================================================
FROM base AS deps
ARG application_name
WORKDIR /app
COPY --parents \
  --exclude='**/dist' \
  --exclude='**/build' \
  --exclude='**/.output' \
  --exclude='**/.next' \
  --exclude='**/.turbo' \
  --exclude='**/node_modules' \
  ./package.json ./bun.lock ./turbo.json ./bunfig.toml \
  ./apps/*/*/package.json \
  ./apps/*/prototype/*/package.json \
  ./packages/*/package.json \
  ./packages/*/*/package.json \
  ./tooling/*/package.json \
  ./patches \
  ./
ENV CI=true
RUN --mount=type=cache,id=bun-store,target=/root/.bun/install/cache \
  bun install --frozen-lockfile

# ============================================================================
# Stage: builder — full pruned source + build → .output/
#
# Shared turbo cache id (`id=turbo`, NOT `id=turbo-<app>`) so workspace package
# builds are reused across all 27 apps in the monorepo. Turbo's cache is
# content-addressed (hash of inputs + dep graph), so two apps building the
# same `@arki/contracts` from the same commit hit the same cache entry.
# ============================================================================
FROM deps AS builder
ARG application_name
COPY --from=pruner /app/out/full/ ./

ENV NODE_ENV=production \
  NITRO_PRESET=bun

RUN --mount=type=cache,id=turbo,target=/app/.turbo \
  turbo build --filter=@${application_name}/start

# ============================================================================
# Stage: runner — minimal Bun runtime image.
# Copies ONLY the Nitro deployment artifact. The vendor SSR code lives in
# .output/server/_libs/ already (phosphor, base-ui, better-auth, tanstack,
# tiptap, orpc, etc. are bundled). Native postgres bindings (libpq, pg-native)
# ship inside .output/server/node_modules/.
# ============================================================================
FROM oven/bun:1-alpine AS runner
ARG application_name
RUN apk add --no-cache curl libc6-compat && \
  addgroup --system --gid 1001 nodejs && \
  adduser --system --uid 1001 appuser

WORKDIR /app
USER appuser

COPY --from=builder --chown=appuser:nodejs \
  /app/apps/${application_name}/start/.output ./.output

EXPOSE 3000
ENV PORT=3000 \
  HOSTNAME="0.0.0.0" \
  NODE_ENV=production

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:3000/api/health || exit 1

CMD ["bun", ".output/server/index.mjs"]
