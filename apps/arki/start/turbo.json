{
  "$schema": "https://turborepo.org/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"]
    },
    "dev": {
      "persistent": true
    },
    "content:generate": {
      "dependsOn": ["^build"],
      "outputs": [".content-collections/generated/**"]
    },
    "typecheck": {
      "dependsOn": ["^topo", "content:generate"],
      "outputs": []
    }
  }
}
