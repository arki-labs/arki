{
  "name": "@arki/vitest-config",
  "version": "0.1.0",
  "description": "Shared Vitest base config for ARKI projects: globals on, Node environment. TypeScript source, so Vitest or a bundler loads it.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arki-labs/arki.git",
    "directory": "tooling/vitest"
  },
  "homepage": "https://arki.dev",
  "bugs": {
    "url": "https://github.com/arki-labs/arki/issues"
  },
  "keywords": [
    "arki",
    "vitest",
    "vitest-config",
    "test",
    "config"
  ],
  "publishConfig": {
    "access": "public"
  },
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src/**",
    "!src/**/*.test.*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "git clean -xdf .cache .turbo node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@testing-library/jest-dom": "catalog:testing",
    "@testing-library/react": "catalog:testing",
    "@testing-library/user-event": "catalog:testing",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:testing",
    "@vitest/ui": "catalog:testing",
    "jsdom": "catalog:text-processing",
    "testcontainers": "catalog:testing",
    "vitest": "catalog:"
  },
  "devDependencies": {
    "@arki/eslint-config": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*"
  }
}
