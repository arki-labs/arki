{
  "name": "@arki/eslint-config",
  "version": "0.1.0",
  "description": "Shared ESLint flat configs for ARKI projects: base, library, React and TanStack Start presets, plus the feature-layer rules.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arki-labs/arki.git",
    "directory": "tooling/eslint"
  },
  "homepage": "https://arki.dev",
  "bugs": {
    "url": "https://github.com/arki-labs/arki/issues"
  },
  "keywords": [
    "arki",
    "eslint",
    "eslint-config",
    "lint",
    "config"
  ],
  "publishConfig": {
    "access": "public"
  },
  "private": true,
  "type": "module",
  "exports": {
    "./base": "./base.js",
    "./feature-layers": "./feature-layers.js",
    "./library": "./library.js",
    "./react": "./react.js",
    "./tanstack-start": "./tanstack-start.js"
  },
  "files": [
    "base.js",
    "feature-layers.js",
    "library.js",
    "react.js",
    "tanstack-start.js",
    "types.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "git clean -xdf .cache .cache .turbo node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "test": "node --test feature-layers.test.js tanstack-start.test.js",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "catalog:",
    "@eslint/compat": "catalog:",
    "@eslint/js": "catalog:",
    "@rushstack/eslint-patch": "catalog:",
    "@tanstack/eslint-plugin-query": "catalog:",
    "@tanstack/eslint-plugin-router": "catalog:",
    "eslint-config-airbnb-base": "catalog:",
    "eslint-import-resolver-alias": "catalog:",
    "eslint-import-resolver-typescript": "catalog:",
    "eslint-plugin-check-file": "catalog:",
    "eslint-plugin-drizzle": "catalog:drizzle",
    "eslint-plugin-import-x": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "eslint-plugin-playwright": "catalog:",
    "eslint-plugin-react": "catalog:",
    "eslint-plugin-react-compiler": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-regexp": "catalog:",
    "eslint-plugin-tailwindcss": "catalog:",
    "eslint-plugin-testing-library": "catalog:",
    "eslint-plugin-tsdoc": "catalog:",
    "eslint-plugin-turbo": "catalog:",
    "eslint-plugin-unicorn": "catalog:",
    "eslint-plugin-unused-imports": "catalog:",
    "eslint-plugin-vitest": "catalog:",
    "typescript-eslint": "catalog:",
    "vite-plugin-eslint": "catalog:build-tools"
  },
  "devDependencies": {
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*"
  }
}
