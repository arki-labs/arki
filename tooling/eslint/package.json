{
  "name": "@arki/eslint-config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./base": "./base.js",
    "./react": "./react.js"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .cache .turbo node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@eslint/compat": "catalog:",
    "@rushstack/eslint-patch": "catalog:",
    "eslint-config-airbnb-base": "catalog:",
    "eslint-import-resolver-alias": "catalog:",
    "eslint-import-resolver-typescript": "catalog:",
    "eslint-plugin-check-file": "catalog:",
    "eslint-plugin-drizzle": "catalog:drizzle",
    "eslint-plugin-eslint-comments": "catalog:",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "eslint-plugin-playwright": "catalog:",
    "eslint-plugin-react": "catalog:",
    "eslint-plugin-react-compiler": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-regexp": "catalog:",
    "eslint-plugin-tailwindcss": "catalog:",
    "eslint-plugin-testing-library": "catalog:",
    "eslint-plugin-tsdoc": "catalog:",
    "eslint-plugin-turbo": "catalog:",
    "eslint-plugin-unicorn": "catalog:",
    "eslint-plugin-unused-imports": "catalog:",
    "eslint-plugin-vitest": "catalog:",
    "typescript-eslint": "catalog:",
    "vite-plugin-eslint": "catalog:build-tools"
  },
  "devDependencies": {
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*"
  }
}
