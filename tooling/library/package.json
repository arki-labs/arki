{
  "name": "@arki/library-tooling",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./api-index-schema": {
      "default": "./src/api-index-schema.ts"
    },
    "./src/*": {
      "default": "./src/*.ts"
    }
  },
  "bin": {
    "arki-api-diff": "./src/api-diff.ts",
    "arki-api-index": "./src/api-index.ts",
    "arki-doc-examples": "./src/doc-examples.ts",
    "arki-error-index": "./src/error-index.ts",
    "arki-layers": "./src/layers.ts",
    "arki-library-check": "./src/library-check.ts",
    "arki-llms": "./src/llms.ts",
    "arki-runtimes": "./src/runtimes.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "prettier": "@arki/prettier-config",
  "dependencies": {
    "@playwright/test": "catalog:testing",
    "esbuild": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@arki/eslint-config": "workspace:*",
    "@arki/prettier-config": "workspace:*",
    "@arki/tsconfig": "workspace:*",
    "@arki/vitest-config": "workspace:*",
    "@babel/core": "^7",
    "@babel/runtime": "^7",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "catalog:",
    "babel-preset-expo": "57.0.14",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@arki/ts": "workspace:*"
  }
}
